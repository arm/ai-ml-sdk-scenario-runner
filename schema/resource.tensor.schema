{
    "$id": "urn:scenario:resource:tensor",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "uid": {
            "type": "string"
        },
        "dims": {
            "type": "array",
            "maxItems": 4,
            "anyOf": [
                {
                    "items": {
                        "const": "?"
                    }
                },
                {
                    "items": {
                        "type": "integer",
                        "minimum": 1
                    }
                }
            ]
        },
        "format": {
            "type": "string"
        },
        "shader_access": {
            "type": "string",
            "enum": ["readonly", "writeonly", "readwrite", "image_read"]
        },
        "src": {
            "type": "string"
        },
        "dst": {
            "type": "string"
        },
        "tiling" : {
            "type": "string",
            "enum" : ["OPTIMAL","LINEAR"]
        },
        "memory_group": {
            "$ref": "urn:scenario:common#/definitions/memory_group"
        },
        "block_scaling": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "block_shape": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 4,
                    "items": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 4294967295
                    }
                },
                "format": {
                    "enum": ["E8M0"]
                },
                "src": {
                    "type": "string",
                    "minLength": 1
                },
                "dst": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "required": ["block_shape", "format"],
            "$ref": "urn:scenario:common#/definitions/mutually_exclusive_optional_src_dst"
        }
    },
    "required": [
        "uid",
        "format",
        "shader_access"
    ],
    "dependentSchemas": {
        "block_scaling": {
            "oneOf": [
                {
                    "required": ["src"],
                    "properties": {
                        "src": {"minLength": 1},
                        "block_scaling": {"required": ["src"]}
                    }
                },
                {
                    "required": ["dst"],
                    "properties": {
                        "dst": {"minLength": 1},
                        "block_scaling": {"required": ["dst"]}
                    }
                },
                {
                    "not": {
                        "anyOf": [
                            {"required": ["src"]},
                            {"required": ["dst"]}
                        ]
                    },
                    "properties": {
                        "block_scaling": {
                            "not": {
                                "anyOf": [
                                    {"required": ["src"]},
                                    {"required": ["dst"]}
                                ]
                            }
                        }
                    }
                }
            ]
        }
    },
    "$ref": "urn:scenario:common#/definitions/mutually_exclusive_optional_src_dst"
}
