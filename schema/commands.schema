{
    "$id": "urn:scenario:commands",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "array",
    "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
            "dispatch_vgf": {
                "$ref": "urn:scenario:command:dispatch_vgf"
            },
            "dispatch_graph": {
                "$ref": "urn:scenario:command:dispatch_graph",
                "deprecated": true
            },
            "dispatch_data_graph": {
                "$ref": "urn:scenario:command:dispatch_data_graph"
            },
            "dispatch_spirv_graph": {
                "$ref": "urn:scenario:command:dispatch_spirv_graph",
                "deprecated": true
            },
            "dispatch_compute": {
                "$ref": "urn:scenario:command:dispatch_compute"
            },
            "dispatch_fragment": {
                "$ref": "urn:scenario:command:dispatch_fragment"
            },
            "pipeline_barrier": {
                "$ref": "urn:scenario:command:pipeline_barrier"
            },
            "dispatch_barrier": {
                "$ref": "urn:scenario:command:dispatch_barrier",
                "deprecated": true
            },
            "frame_boundary": {
                "$ref": "urn:scenario:command:frame_boundary"
            },
            "mark_boundary": {
                "$ref": "urn:scenario:command:mark_boundary",
                "deprecated": true
            },
            "dispatch_optical_flow": {
                "$ref": "urn:scenario:command:dispatch_optical_flow"
            }
        },
        "oneOf": [
            { "required": ["dispatch_vgf"] },
            { "required": ["dispatch_graph"] },
            { "required": ["dispatch_data_graph"] },
            { "required": ["dispatch_spirv_graph"] },
            { "required": ["dispatch_compute"] },
            { "required": ["dispatch_fragment"] },
            { "required": ["pipeline_barrier"] },
            { "required": ["dispatch_barrier"] },
            { "required": ["frame_boundary"] },
            { "required": ["mark_boundary"] },
            { "required": ["dispatch_optical_flow"] }
        ]
    }
}
