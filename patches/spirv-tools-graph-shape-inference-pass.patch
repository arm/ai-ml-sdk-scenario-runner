+Pass::Status ShapeGraphInstructionTransposeOp(
+    IRContext* context, uint32_t perms_id, uint32_t input_id,
+    std::vector<int64_t>* output_shape) {
+  auto input_shape = GetTensorShape(context, input_id);
+  if (!input_shape) {
+    return ShapeFailure(context, "Transpose input shape must be known");
+  }
+  std::vector<int32_t> perms;
+  if (GetI32TensorConstantValues(context, "Transpose permutation", perms_id,
+                                 input_shape.value().size(),
+                                 &perms) == Pass::Status::Failure) {
+    return Pass::Status::Failure;
+  }
+
+  std::vector<int64_t> transposed_shape;
+  transposed_shape.reserve(input_shape.value().size());
+  std::vector<bool> used_perms(input_shape.value().size(), false);
+  for (auto perm : perms) {
+    if (perm < 0 || static_cast<size_t>(perm) >= input_shape.value().size()) {
+      return ShapeFailure(
+          context, "Transpose permutation index outside of input tensor rank");
+    }
+    auto perm_index = static_cast<size_t>(perm);
+    if (used_perms[perm_index]) {
+      return ShapeFailure(context,
+                          "Transpose permutation index used more than once");
+    }
+    used_perms[perm_index] = true;
+    transposed_shape.push_back(input_shape.value()[perm_index]);
+  }
+
+  *output_shape = transposed_shape;
+  return Pass::Status::SuccessWithoutChange;
+}
