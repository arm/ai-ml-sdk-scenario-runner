+void SetError(std::string* error_msg, std::string_view message) {
+  if (error_msg) {
+    *error_msg = message;
+  }
+}
+
+Pass::Status ShapeFailure(IRContext* context, const std::string& message) {
+  context->consumer()(SPV_MSG_ERROR, "", {0, 0, 0}, message.c_str());
+  return Pass::Status::Failure;
+}
+
+namespace {
+
+std::optional<uint64_t> DecodeIntegerConstantValue(
+    const analysis::Constant* constant, uint32_t bit_width,
+    std::string* error_msg) {
+  if (constant == nullptr) {
+    SetError(error_msg, "must be known");
+    return std::nullopt;
+  }
+
+  const auto* integer_type = constant->type()->AsInteger();
+  if (integer_type == nullptr || integer_type->width() > 64 ||
+      (bit_width != 0 && integer_type->width() != bit_width) ||
+      (constant->AsIntConstant() == nullptr &&
+       constant->AsNullConstant() == nullptr)) {
+    if (bit_width == 0) {
+      SetError(error_msg, "must be an integer constant of at most 64 bits");
+    } else {
+      SetError(error_msg, "must be a " + std::to_string(bit_width) +
+                              "-bit integer constant");
+    }
+    return std::nullopt;
+  }
+
+  return constant->GetZeroExtendedValue();
+}
+
+std::optional<uint64_t> GetTensorRank(IRContext* context,
+                                      const analysis::TensorARM* tensor_type,
+                                      std::string* error_msg = nullptr) {
+  std::string detail;
+  const auto rank =
+      GetIntegerConstantValue(context, tensor_type->rank_id(), 0, &detail);
+  if (!rank.has_value()) {
+    SetError(error_msg, " rank " + detail);
+    return std::nullopt;
+  }
+  return rank;
+}
+
+}  // namespace
+
+std::optional<uint64_t> GetIntegerConstantValue(IRContext* context, uint32_t id,
+                                                uint32_t bit_width,
+                                                std::string* error_msg) {
+  const auto* inst = context->get_def_use_mgr()->GetDef(id);
+  if (inst == nullptr || spvOpcodeIsSpecConstant(inst->opcode())) {
+    SetError(error_msg, "must be known");
+    return std::nullopt;
+  }
+
+  const auto* constant = context->get_constant_mgr()->FindDeclaredConstant(id);
+  if (constant == nullptr) {
+    SetError(error_msg, "must be known");
+    return std::nullopt;
+  }
+
+  return DecodeIntegerConstantValue(constant, bit_width, error_msg);
+}
+
+std::optional<std::pair<uint32_t, uint32_t>> GetDSBForVar(IRContext* context,
+                                                          uint32_t var_id) {
+  auto decos = context->get_decoration_mgr()->GetDecorationsFor(var_id, false);
+  constexpr uint32_t kUnset = std::numeric_limits<uint32_t>::max();
+  uint32_t set = kUnset, binding = kUnset;
+  for (const auto& deco : decos) {
+    spv::Decoration d = spv::Decoration(deco->GetSingleWordInOperand(1u));
+    if (d == spv::Decoration::DescriptorSet) {
+      set = deco->GetSingleWordInOperand(2u);
+    } else if (d == spv::Decoration::Binding) {
+      binding = deco->GetSingleWordInOperand(2u);
+    }
+  }
+  if (set == kUnset || binding == kUnset) {
+    return std::nullopt;
+  }
+  return std::make_pair(set, binding);
+}
+
+std::optional<spv::StorageClass> GetVariableStorageClass(
+    IRContext* context, uint32_t var_id, std::string* error_msg) {
+  auto var_inst = context->get_def_use_mgr()->GetDef(var_id);
+  if (var_inst == nullptr) {
+    SetError(error_msg,
+             "OpVariable " + std::to_string(var_id) + " is not defined");
+    return std::nullopt;
+  }
+  if (var_inst->opcode() != spv::Op::OpVariable) {
+    SetError(error_msg, "Expected OpVariable " + std::to_string(var_id) +
+                            " but found a different instruction");
+    return std::nullopt;
+  }
+  if (var_inst->NumInOperands() == 0) {
+    SetError(error_msg, "OpVariable " + std::to_string(var_id) +
+                            " is missing storage class operand");
+    return std::nullopt;
+  }
+  return spv::StorageClass(var_inst->GetSingleWordInOperand(0));
+}
+
+const analysis::TensorARM* GetTensorResultType(IRContext* context,
+                                               const Instruction* inst) {
+  if (inst == nullptr) {
+    return nullptr;
+  }
+  auto type = context->get_type_mgr()->GetType(inst->type_id());
+  return type == nullptr ? nullptr : type->AsTensorARM();
+}
+
+const analysis::TensorARM* GetTensorVariableType(IRContext* context,
+                                                 uint32_t var_id,
+                                                 std::string* error_msg) {
+  auto var_inst = context->get_def_use_mgr()->GetDef(var_id);
+  if (var_inst == nullptr) {
+    SetError(error_msg,
+             "OpVariable " + std::to_string(var_id) + " is not defined");
+    return nullptr;
+  }
+  if (var_inst->opcode() != spv::Op::OpVariable) {
+    SetError(error_msg, "Expected OpVariable " + std::to_string(var_id) +
+                            " but found a different instruction");
+    return nullptr;
+  }
+  auto ptrty = context->get_type_mgr()->GetType(var_inst->type_id());
+  if (ptrty == nullptr || ptrty->kind() != analysis::Type::Kind::kPointer) {
+    SetError(error_msg, "OpVariable " + std::to_string(var_id) +
+                            " does not have a pointer type");
+    return nullptr;
+  }
+  auto pointee_type = ptrty->AsPointer()->pointee_type();
+  if (pointee_type == nullptr ||
+      pointee_type->kind() != analysis::Type::Kind::kTensorARM) {
+    SetError(error_msg, "OpVariable " + std::to_string(var_id) +
+                            " pointee type is not OpTypeTensorARM");
+    return nullptr;
+  }
+  return pointee_type->AsTensorARM();
+}
+
+std::optional<std::vector<int64_t>> GetTensorTypeShape(
+    IRContext* context, const analysis::TensorARM* tensor_type) {
+  if (tensor_type == nullptr || tensor_type->shape_id() == 0) {
+    return std::nullopt;
+  }
+  const auto* shape_inst =
+      context->get_def_use_mgr()->GetDef(tensor_type->shape_id());
+  const auto rank = GetTensorRank(context, tensor_type);
+  if (!rank.has_value() || shape_inst == nullptr ||
+      spvOpcodeIsSpecConstant(shape_inst->opcode())) {
+    return std::nullopt;
+  }
+
+  auto shape_constant = context->get_constant_mgr()->FindDeclaredConstant(
+      tensor_type->shape_id());
+  if (shape_constant == nullptr) {
+    return std::nullopt;
+  }
+  auto shape_composite = shape_constant->AsCompositeConstant();
+  if (shape_composite == nullptr) {
+    return std::nullopt;
+  }
+  std::vector<int64_t> shape;
+  for (const auto* component : shape_composite->GetComponents()) {
+    const auto dim = DecodeIntegerConstantValue(component, 0, nullptr);
+    if (!dim.has_value() || dim.value() == 0 ||
+        dim.value() > std::numeric_limits<uint32_t>::max()) {
+      return std::nullopt;
+    }
+    shape.push_back(static_cast<int64_t>(dim.value()));
+  }
+  if (rank.value() != shape.size()) {
+    return std::nullopt;
+  }
+  return shape;
+}
+
+std::optional<std::vector<int64_t>> GetTensorShape(IRContext* context,
+                                                   uint32_t id) {
+  auto inst = context->get_def_use_mgr()->GetDef(id);
+  if (inst == nullptr) {
+    return std::nullopt;
+  }
+  auto tensor_type = GetTensorResultType(context, inst);
+  return GetTensorTypeShape(context, tensor_type);
+}
+
+std::optional<analysis::TensorARM*> GetOrCreateShapedTensorType(
+    IRContext* context, const analysis::Type* tensor_elem_type,
+    const std::vector<int64_t>& target_shape, std::string* error_msg) {
+  if (tensor_elem_type == nullptr) {
+    SetError(error_msg, "Cannot create a tensor type without an element type");
+    return std::nullopt;
+  }
+  if (target_shape.empty()) {
+    SetError(error_msg, "Cannot create a ranked tensor type with rank 0");
+    return std::nullopt;
+  }
+
+  auto cstmgr = context->get_constant_mgr();
+  uint32_t tensor_rank = static_cast<uint32_t>(target_shape.size());
+  auto rankcst_id = cstmgr->GetUIntConstId(tensor_rank);
+  std::vector<uint32_t> shape_ids;
+  for (auto dim : target_shape) {
+    if (dim <= 0) {
+      SetError(error_msg,
+               "Cannot create a tensor type with non-positive dimension " +
+                   std::to_string(dim));
+      return std::nullopt;
+    }
+    if (static_cast<uint64_t>(dim) > std::numeric_limits<uint32_t>::max()) {
+      SetError(error_msg, "Cannot create a tensor type with dimension " +
+                              std::to_string(dim) +
+                              " because it does not fit in 32 bits");
+      return std::nullopt;
+    }
+    auto c = cstmgr->GetUIntConstId(static_cast<uint32_t>(dim));
+    shape_ids.push_back(c);
+  }
+  auto tymgr = context->get_type_mgr();
+  analysis::Integer i(32, false);
+  analysis::Type* shape_array_elem_type =
+      context->get_type_mgr()->GetRegisteredType(&i);
+  analysis::Array array_type(
+      shape_array_elem_type,
+      analysis::Array::LengthInfo{rankcst_id, {0, tensor_rank}});
+
+  analysis::Type* shape_arr_type = tymgr->GetRegisteredType(&array_type);
+
+  auto shape_constant = cstmgr->GetConstant(shape_arr_type, shape_ids);
+  auto shape_constant_inst = cstmgr->GetDefiningInstruction(shape_constant);
+  if (shape_constant_inst == nullptr) {
+    SetError(error_msg, "Cannot create a tensor shape constant");
+    return std::nullopt;
+  }
+  auto shape_constant_id = shape_constant_inst->result_id();
+  analysis::TensorARM tensor_type_tpl(tensor_elem_type, rankcst_id,
+                                      shape_constant_id);
+  return tymgr->GetRegisteredType(&tensor_type_tpl)->AsTensorARM();
+}
+
+Pass::Status GetI32TensorConstantValues(IRContext* context,
+                                        std::string_view name, uint32_t id,
+                                        size_t num_elements,
+                                        std::vector<int32_t>* values) {
+  values->clear();
+  const std::string value_name(name);
+
+  auto inst = context->get_def_use_mgr()->GetDef(id);
+  if (inst == nullptr) {
+    return ShapeFailure(context, value_name + " value definition must exist");
+  }
+  if (spvOpcodeIsSpecConstant(inst->opcode())) {
+    return ShapeFailure(context, value_name + " value must be known");
+  }
+
+  auto tensor_type = GetTensorResultType(context, inst);
+  if (tensor_type == nullptr) {
+    return ShapeFailure(context, value_name + " value must have tensor type");
+  }
+  auto element_type = tensor_type->element_type()->AsInteger();
+  if (element_type == nullptr || element_type->width() != 32) {
+    return ShapeFailure(context, value_name +
+                                     " value must have 32-bit integer "
+                                     "element type");
+  }
+
+  auto shape = GetTensorTypeShape(context, tensor_type);
+  if (!shape.has_value()) {
+    return ShapeFailure(context, value_name + " tensor shape must be known");
+  }
+
+  if (shape.value().size() != 1 ||
+      shape.value()[0] != static_cast<int64_t>(num_elements)) {
+    return ShapeFailure(context, value_name + " tensor shape must be [" +
+                                     std::to_string(num_elements) + "]");
+  }
+
+  auto constant = context->get_constant_mgr()->FindDeclaredConstant(id);
+  if (constant == nullptr) {
+    return ShapeFailure(context, value_name + " value must be known");
+  }
+  if (constant->AsNullConstant() != nullptr) {
+    values->assign(num_elements, 0);
+    return Pass::Status::SuccessWithoutChange;
+  }
+
+  const analysis::TensorConstant* tensor_constant =
+      constant->AsTensorConstant();
+  if (tensor_constant == nullptr) {
+    return ShapeFailure(context,
+                        value_name + " value must be a tensor constant");
+  }
+
+  auto instruction = context->get_def_use_mgr()->GetDef(id);
+  bool is_splat =
+      instruction != nullptr &&
+      instruction->opcode() == spv::Op::OpConstantCompositeReplicateEXT;
+  const auto& components = tensor_constant->GetComponents();
+  // Read replicated tensor constants from either the original single
+  // constituent or the constant manager's expanded component list.
+  if (is_splat) {
+    if (components.size() == 1) {
+      const auto* component = components.front()->AsIntConstant();
+      if (component == nullptr) {
+        return ShapeFailure(
+            context, value_name + " value must contain integer elements");
+      }
+      values->assign(num_elements, component->GetS32());
+      return Pass::Status::SuccessWithoutChange;
+    }
+
+    if (components.size() != num_elements) {
+      return ShapeFailure(
+          context,
+          value_name + " replicated value has unexpected element count");
+    }
+  }
+
+  if (components.size() != num_elements) {
+    return ShapeFailure(context,
+                        value_name + " value has unexpected element count");
+  }
+
+  values->reserve(num_elements);
+  for (auto&& component : components) {
+    if (component->AsIntConstant() == nullptr) {
+      return ShapeFailure(context,
+                          value_name + " value must contain integer elements");
+    }
+    values->push_back(component->GetS32());
+  }
+  return Pass::Status::SuccessWithoutChange;
+}
+
+Pass::Status ValidateTensorRank(IRContext* context, std::string_view name,
+                                const analysis::TensorARM* tensor_type,
+                                size_t expected_rank) {
+  const std::string tensor_name(name);
+  if (tensor_type == nullptr) {
+    return ShapeFailure(context, tensor_name + " type must be OpTypeTensorARM");
+  }
+  if (!tensor_type->is_ranked()) {
+    return Pass::Status::SuccessWithoutChange;
+  }
+
+  std::string error_msg;
+  const auto existing_rank = GetTensorRank(context, tensor_type, &error_msg);
+  if (!existing_rank.has_value()) {
+    return ShapeFailure(context, tensor_name + error_msg);
+  }
+  if (existing_rank.value() != expected_rank) {
+    return ShapeFailure(context, tensor_name + " rank " +
+                                     std::to_string(existing_rank.value()) +
+                                     " conflicts with inferred rank " +
+                                     std::to_string(expected_rank));
+  }
+  return Pass::Status::SuccessWithoutChange;
+}
+
+Pass::Status ValidateOutputDimension(IRContext* context, std::string_view name,
+                                     int64_t value) {
+  if (value <= 0 ||
+      static_cast<uint64_t>(value) > std::numeric_limits<uint32_t>::max()) {
+    return ShapeFailure(
+        context, std::string(name) + " dimension is outside the valid range");
+  }
+  return Pass::Status::SuccessWithoutChange;
+}
+
+Pass::Status ShapeGraphInstructionSingleOutput(
+    IRContext* context, Instruction* inst,
+    const std::vector<int64_t>& output_shape) {
+  auto output_type = GetTensorResultType(context, inst);
+  if (output_type == nullptr) {
+    return ShapeFailure(context,
+                        "Single-output result type must be OpTypeTensorARM");
+  }
+  if (ValidateTensorRank(context, "Single-output result", output_type,
+                         output_shape.size()) == Pass::Status::Failure) {
+    return Pass::Status::Failure;
+  }
+  auto existing_shape = GetTensorTypeShape(context, output_type);
+  if (output_type->is_shaped() && !existing_shape.has_value()) {
+    return ShapeFailure(context,
+                        "Single-output result shape must be statically known");
+  }
+  if (existing_shape.has_value() && existing_shape.value() != output_shape) {
+    return ShapeFailure(
+        context,
+        "Existing graph instruction result shape conflicts with inferred "
+        "shape");
+  }
+  std::string error_msg;
+  auto output_shaped_tensor_type = GetOrCreateShapedTensorType(
+      context, output_type->element_type(), output_shape, &error_msg);
+  if (!output_shaped_tensor_type.has_value()) {
+    return ShapeFailure(context, error_msg);
+  }
+  uint32_t new_output_type_id = context->get_type_mgr()->GetTypeInstruction(
+      output_shaped_tensor_type.value());
+  if (new_output_type_id == 0) {
+    return ShapeFailure(context,
+                        "Single-output shaped tensor type has no type id");
+  }
+  uint32_t existing_output_type_id = inst->type_id();
+  if (new_output_type_id == existing_output_type_id) {
+    return Pass::Status::SuccessWithoutChange;
+  }
+  inst->SetResultType(new_output_type_id);
+  return Pass::Status::SuccessWithChange;
+}
+
+Pass::Status ShapeGraphInstructionMultiOutput(
+    IRContext* context, Instruction* inst,
+    const std::vector<std::vector<int64_t>>& output_shapes) {
+  auto type_mgr = context->get_type_mgr();
+  auto output_type = type_mgr->GetType(inst->type_id());
+  if (output_type == nullptr) {
+    return ShapeFailure(context, "Multi-output result type is not known");
+  }
+  auto output_struct_type = output_type->AsStruct();
+  if (!output_struct_type) {
+    return ShapeFailure(context, "Multi-output result type must be a struct");
+  }
+  if (output_struct_type->element_types().size() != output_shapes.size()) {
+    return ShapeFailure(context,
+                        "Multi-output result count must match inferred shapes");
+  }
+
+  std::vector<const analysis::Type*> shaped_member_types;
+  for (size_t i = 0; i < output_shapes.size(); ++i) {
+    auto output_tensor_type =
+        output_struct_type->element_types()[i]->AsTensorARM();
+    if (!output_tensor_type) {
+      return ShapeFailure(context,
+                          "Multi-output struct members must be tensor types");
+    }
+    if (ValidateTensorRank(context, "Multi-output result member",
+                           output_tensor_type,
+                           output_shapes[i].size()) == Pass::Status::Failure) {
+      return Pass::Status::Failure;
+    }
+    auto existing_shape = GetTensorTypeShape(context, output_tensor_type);
+    if (output_tensor_type->is_shaped() && !existing_shape.has_value()) {
+      return ShapeFailure(
+          context, "Multi-output result member shape must be statically known");
+    }
+    if (existing_shape.has_value() &&
+        existing_shape.value() != output_shapes[i]) {
+      return ShapeFailure(
+          context,
+          "Existing graph instruction result shape conflicts with inferred "
+          "shape");
+    }
+    std::string error_msg;
+    auto shaped_member_type =
+        GetOrCreateShapedTensorType(context, output_tensor_type->element_type(),
+                                    output_shapes[i], &error_msg);
+    if (!shaped_member_type.has_value()) {
+      return ShapeFailure(context, error_msg);
+    }
+    shaped_member_types.push_back(shaped_member_type.value());
+  }
+
+  analysis::Struct output_struct(shaped_member_types);
+  auto shaped_output_type = type_mgr->GetRegisteredType(&output_struct);
+  uint32_t new_output_type_id =
+      type_mgr->GetTypeInstruction(shaped_output_type);
+  if (new_output_type_id == 0) {
+    return ShapeFailure(context,
+                        "Multi-output shaped struct type has no type id");
+  }
+  uint32_t existing_output_type_id = inst->type_id();
+  if (new_output_type_id == existing_output_type_id) {
+    return Pass::Status::SuccessWithoutChange;
+  }
+
+  inst->SetResultType(new_output_type_id);
+  return Pass::Status::SuccessWithChange;
+}
+
+}  // namespace opt
+}  // namespace spvtools
