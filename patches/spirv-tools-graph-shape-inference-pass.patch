+SPIRV_TOOLS_EXPORT bool spvOptimizerRegisterGraphShapePass(
+    spv_optimizer_t* optimizer, const size_t num_interface_shapes,
+    const spv_graph_interface_shape* interface_shape_inputs,
+    spv_graph_output_shape_consumer consumer, void* user_data) {
+  auto* cpp_optimizer = reinterpret_cast<spvtools::Optimizer*>(optimizer);
+  std::vector<spvtools::GraphInterfaceShape> interface_shapes;
+  std::string error_msg;
+  if (!spvtools::opt::CopyGraphInterfaceShapes(
+          num_interface_shapes, interface_shape_inputs, &interface_shapes,
+          &error_msg)) {
+    spvtools::Errorf(cpp_optimizer->consumer(), nullptr, {},
+                     "Invalid graph-shape interface tensor shapes: %s",
+                     error_msg.c_str());
+    return false;
+  }
+
+  spvtools::GraphOutputShapeConsumer cpp_consumer;
+  if (consumer != nullptr) {
+    cpp_consumer =
+        [consumer, user_data](
+            const std::vector<spvtools::GraphInterfaceShape>& output_shapes) {
+          std::vector<spv_graph_interface_shape> c_output_shapes;
+          c_output_shapes.reserve(output_shapes.size());
+          for (const auto& output_shape : output_shapes) {
+            c_output_shapes.push_back(
+                {output_shape.descriptor_set, output_shape.binding,
+                 static_cast<uint32_t>(output_shape.shape.size()),
+                 output_shape.shape.data()});
+          }
+          consumer(user_data, c_output_shapes.size(),
+                   c_output_shapes.empty() ? nullptr : c_output_shapes.data());
+        };
+  }
+
+  cpp_optimizer->RegisterPass(spvtools::CreateGraphShapePass(
+      interface_shapes, std::move(cpp_consumer)));
+  return true;
+}
