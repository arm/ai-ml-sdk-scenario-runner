+Pass::Status ShapeGraphInstructionSelectOp(IRContext* context,
+                                           uint32_t input1_id,
+                                           uint32_t input2_id,
+                                           uint32_t input3_id,
+                                           std::vector<int64_t>* output_shape) {
+  auto input1_shape = GetTensorShape(context, input1_id);
+  if (!input1_shape) {
+    return ShapeFailure(context, "Select input 1 shape must be known");
+  }
+  auto input2_shape = GetTensorShape(context, input2_id);
+  if (!input2_shape) {
+    return ShapeFailure(context, "Select input 2 shape must be known");
+  }
+  auto input3_shape = GetTensorShape(context, input3_id);
+  if (!input3_shape) {
+    return ShapeFailure(context, "Select input 3 shape must be known");
+  }
+
+  std::vector<int64_t> intermediate_output_shape;
+  auto status =
+      BroadcastShapes(context, input1_shape.value(), input2_shape.value(),
+                      &intermediate_output_shape);
+  if (status == Pass::Status::Failure) {
+    return status;
+  }
+  return BroadcastShapes(context, intermediate_output_shape,
+                         input3_shape.value(), output_shape);
+}
