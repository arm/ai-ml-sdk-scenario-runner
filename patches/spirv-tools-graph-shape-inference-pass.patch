+#include "source/opt/graph_shape_arm_motion_engine.h"
+
+#include <limits>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "source/opt/graph_shape_arm_motion_engine_operands.h"
+#include "source/opt/graph_shape_extinst_operand_reader.h"
+#include "source/opt/graph_shape_util.h"
+#include "source/opt/instruction.h"
+#include "spirv/unified1/ArmMotionEngine.100.h"
+
+namespace spvtools {
+namespace opt {
+
+namespace {
+
+namespace operands = spvtools::opt::arm_motion_engine100_operands;
+
+using ArmMotionEngineOperandRole = operands::OperandRole;
+
+struct ArmMotionEngineOperandTraits {
+  using OperandRole = operands::OperandRole;
+  static constexpr spv_ext_inst_type_t kExtInstType =
+      SPV_EXT_INST_TYPE_ARM_MOTION_ENGINE_100;
+  static constexpr uint32_t kExtInstOpcode = operands::kExtInstOpcode;
+  static constexpr uint32_t kInvalidOperand = operands::kInvalidOperand;
+
+  static std::string_view InstructionSetName() {
+    return "Arm.MotionEngine.100";
+  }
+};
+
+using ArmMotionEngineOperandReader =
+    ExtInstOperandReader<ArmMotionEngineOperandTraits>;
+
+Pass::Status MultiplyOutputDimensions(IRContext* context, std::string_view name,
+                                      int64_t lhs, int64_t rhs,
+                                      int64_t* result) {
+  if (ValidateOutputDimension(context, name, lhs) == Pass::Status::Failure ||
+      ValidateOutputDimension(context, name, rhs) == Pass::Status::Failure) {
+    return Pass::Status::Failure;
+  }
+  const uint64_t product =
+      static_cast<uint64_t>(lhs) * static_cast<uint64_t>(rhs);
+  if (product > std::numeric_limits<uint32_t>::max()) {
+    return ShapeFailure(
+        context, std::string(name) + " dimension is outside the valid range");
+  }
+  *result = static_cast<int64_t>(product);
+  return Pass::Status::SuccessWithoutChange;
+}
+
+Pass::Status GetBlockMatchInputShape(IRContext* context, uint32_t input_id,
+                                     std::vector<int64_t>* input_shape) {
+  auto input0_shape = GetTensorShape(context, input_id);
+  if (!input0_shape.has_value()) {
+    return ShapeFailure(context,
+                        "Arm.MotionEngine.100 SAD input 0 shape must be known");
+  }
+  const auto& input0_shape_value = input0_shape.value();
+
+  if (input0_shape_value.size() != 4) {
+    return ShapeFailure(context,
+                        "Arm.MotionEngine.100 SAD input 0 must be rank 4");
+  }
+
+  *input_shape = input0_shape_value;
+  return Pass::Status::SuccessWithoutChange;
+}
+
+Pass::Status GetOutputSpatialShape(IRContext* context,
+                                   const std::vector<int64_t>& input_shape,
+                                   uint32_t input_strides_id, int64_t* out_h,
+                                   int64_t* out_w) {
+  std::vector<int32_t> input_strides;
+  auto status = GetI32TensorConstantValues(
+      context, "Arm.MotionEngine.100 SAD input strides", input_strides_id, 2,
+      &input_strides);
+  if (status == Pass::Status::Failure) return status;
+  int32_t input_stride_y = input_strides[0];
+  int32_t input_stride_x = input_strides[1];
+
+  if (input_stride_y <= 0 || input_stride_x <= 0) {
+    return ShapeFailure(context,
+                        "Arm.MotionEngine.100 SAD input strides must be > 0");
+  }
+
+  // Integer division floors any trailing partial stride step.
+  *out_h = input_shape[2] / input_stride_y;
+  *out_w = input_shape[3] / input_stride_x;
+  if (ValidateOutputDimension(context, "Arm.MotionEngine.100 SAD output height",
+                              *out_h) == Pass::Status::Failure ||
+      ValidateOutputDimension(context, "Arm.MotionEngine.100 SAD output width",
+                              *out_w) == Pass::Status::Failure) {
+    return Pass::Status::Failure;
+  }
+  return Pass::Status::SuccessWithoutChange;
+}
+
+Pass::Status ShapeGraphInstructionMinSadOp(IRContext* context,
+                                           uint32_t input_strides_id,
+                                           uint32_t input0_id,
+                                           std::vector<int64_t>* output_shape) {
+  std::vector<int64_t> input_shape;
+  auto status = GetBlockMatchInputShape(context, input0_id, &input_shape);
+  if (status == Pass::Status::Failure) return status;
+
+  int64_t out_h = 0;
+  int64_t out_w = 0;
+  status = GetOutputSpatialShape(context, input_shape, input_strides_id, &out_h,
+                                 &out_w);
+  if (status == Pass::Status::Failure) return status;
+
+  int64_t flow_width = 0;
+  if (MultiplyOutputDimensions(context,
+                               "Arm.MotionEngine.100 MIN_SAD flow width", out_w,
+                               2, &flow_width) == Pass::Status::Failure) {
+    return Pass::Status::Failure;
+  }
+
+  // MIN_SAD output: [N, C, H / stride_y, 2 * (W / stride_x)].
+  *output_shape = {input_shape[0], input_shape[1], out_h, flow_width};
+  return Pass::Status::SuccessWithoutChange;
+}
+
+Pass::Status ShapeGraphInstructionMinSadCostOp(
+    IRContext* context, uint32_t input_strides_id, uint32_t input0_id,
+    std::vector<std::vector<int64_t> >* output_shapes) {
+  std::vector<int64_t> input_shape;
+  auto status = GetBlockMatchInputShape(context, input0_id, &input_shape);
+  if (status == Pass::Status::Failure) return status;
+
+  int64_t out_h = 0;
+  int64_t out_w = 0;
+  status = GetOutputSpatialShape(context, input_shape, input_strides_id, &out_h,
+                                 &out_w);
+  if (status == Pass::Status::Failure) return status;
+
+  int64_t flow_width = 0;
+  if (MultiplyOutputDimensions(
+          context, "Arm.MotionEngine.100 MIN_SAD_COST flow width", out_w, 2,
+          &flow_width) == Pass::Status::Failure) {
+    return Pass::Status::Failure;
+  }
+
+  // MIN_SAD_COST outputs: flow [N, C, OH, 2 * OW], cost [N, C, OH, OW].
+  *output_shapes = {
+      {input_shape[0], input_shape[1], out_h, flow_width},
+      {input_shape[0], input_shape[1], out_h, out_w},
+  };
+  return Pass::Status::SuccessWithoutChange;
+}
+
+Pass::Status ShapeGraphInstructionRawSadOp(IRContext* context,
+                                           uint32_t search_window_sizes_id,
+                                           uint32_t input_strides_id,
+                                           uint32_t input0_id,
+                                           std::vector<int64_t>* output_shape) {
+  std::vector<int64_t> input_shape;
+  auto status = GetBlockMatchInputShape(context, input0_id, &input_shape);
+  if (status == Pass::Status::Failure) return status;
+
+  std::vector<int32_t> search_window_sizes;
+  status = GetI32TensorConstantValues(
+      context, "Arm.MotionEngine.100 RAW_SAD search window sizes",
+      search_window_sizes_id, 2, &search_window_sizes);
+  if (status == Pass::Status::Failure) return status;
+  int32_t search_h = search_window_sizes[0];
+  int32_t search_w = search_window_sizes[1];
+  if (search_h <= 0 || search_w <= 0) {
+    return ShapeFailure(
+        context,
+        "Arm.MotionEngine.100 RAW_SAD search window sizes must be > 0");
+  }
+
+  int64_t out_h = 0;
+  int64_t out_w = 0;
+  status = GetOutputSpatialShape(context, input_shape, input_strides_id, &out_h,
+                                 &out_w);
+  if (status == Pass::Status::Failure) return status;
+
+  int64_t output_channels = 0;
+  if (MultiplyOutputDimensions(context,
+                               "Arm.MotionEngine.100 RAW_SAD output channels",
+                               input_shape[1], search_h,
+                               &output_channels) == Pass::Status::Failure ||
+      MultiplyOutputDimensions(context,
+                               "Arm.MotionEngine.100 RAW_SAD output channels",
+                               output_channels, search_w,
+                               &output_channels) == Pass::Status::Failure) {
+    return Pass::Status::Failure;
+  }
+
+  // RAW_SAD output: [N, C * search_h * search_w, OH, OW].
+  *output_shape = {input_shape[0], output_channels, out_h, out_w};
+  return Pass::Status::SuccessWithoutChange;
+}
+
+}  // namespace
+
+Pass::Status ShapeGraphInstructionArmMotionEngine(IRContext* context,
+                                                  Instruction* inst) {
+  ArmMotionEngineOperandReader motion_engine_operands(context, inst);
+  if (motion_engine_operands.ReadOpcode() == Pass::Status::Failure) {
+    return Pass::Status::Failure;
+  }
+  uint32_t motion_engine_op = motion_engine_operands.opcode();
+
+  switch (motion_engine_op) {
+    case ArmMotionEngineMIN_SAD: {
+      uint32_t input_strides_id = 0;
+      uint32_t input0_id = 0;
+      if (motion_engine_operands.ReadOperands(
+              {{ArmMotionEngineOperandRole::kInputStrides, &input_strides_id},
+               {ArmMotionEngineOperandRole::kInput0, &input0_id}}) ==
+          Pass::Status::Failure) {
+        return Pass::Status::Failure;
+      }
+      std::vector<int64_t> output_shape;
+      auto status = ShapeGraphInstructionMinSadOp(context, input_strides_id,
+                                                  input0_id, &output_shape);
+      if (status == Pass::Status::Failure) return status;
+      return ShapeGraphInstructionSingleOutput(context, inst, output_shape);
+    }
+    case ArmMotionEngineMIN_SAD_COST: {
+      uint32_t input_strides_id = 0;
+      uint32_t input0_id = 0;
+      if (motion_engine_operands.ReadOperands(
+              {{ArmMotionEngineOperandRole::kInputStrides, &input_strides_id},
+               {ArmMotionEngineOperandRole::kInput0, &input0_id}}) ==
+          Pass::Status::Failure) {
+        return Pass::Status::Failure;
+      }
+      std::vector<std::vector<int64_t> > output_shapes;
+      auto status = ShapeGraphInstructionMinSadCostOp(
+          context, input_strides_id, input0_id, &output_shapes);
+      if (status == Pass::Status::Failure) return status;
+      return ShapeGraphInstructionMultiOutput(context, inst, output_shapes);
+    }
+    case ArmMotionEngineRAW_SAD: {
+      uint32_t search_window_sizes_id = 0;
+      uint32_t input_strides_id = 0;
+      uint32_t input0_id = 0;
+      if (motion_engine_operands.ReadOperands(
+              {{ArmMotionEngineOperandRole::kSearchWindowSizes,
+                &search_window_sizes_id},
+               {ArmMotionEngineOperandRole::kInputStrides, &input_strides_id},
+               {ArmMotionEngineOperandRole::kInput0, &input0_id}}) ==
+          Pass::Status::Failure) {
+        return Pass::Status::Failure;
+      }
+      std::vector<int64_t> output_shape;
+      auto status = ShapeGraphInstructionRawSadOp(
+          context, search_window_sizes_id, input_strides_id, input0_id,
+          &output_shape);
+      if (status == Pass::Status::Failure) return status;
+      return ShapeGraphInstructionSingleOutput(context, inst, output_shape);
+    }
+    default:
+      return ShapeFailure(context, "Unhandled Arm.MotionEngine.100 operator");
+  }
+}
+
+}  // namespace opt
+}  // namespace spvtools
