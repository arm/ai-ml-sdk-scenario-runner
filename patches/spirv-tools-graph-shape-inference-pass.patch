+constexpr int64_t kInt64Min = std::numeric_limits<int64_t>::min();
+constexpr int64_t kInt64Max = std::numeric_limits<int64_t>::max();
+constexpr int64_t kResizeParameterLimit = 16;
+using TosaOperandRole = operands::OperandRole;
+
+struct TosaOperandTraits {
+  using OperandRole = operands::OperandRole;
+  static constexpr spv_ext_inst_type_t kExtInstType =
+      SPV_EXT_INST_TYPE_TOSA_001000_1;
+  static constexpr uint32_t kExtInstOpcode = operands::kExtInstOpcode;
+  static constexpr uint32_t kInvalidOperand = operands::kInvalidOperand;
+
+  static std::string_view InstructionSetName() { return "TOSA"; }
+};
+
+using TosaOperandReader = ExtInstOperandReader<TosaOperandTraits>;
+
+bool CheckedAdd(int64_t lhs, int64_t rhs, int64_t* result) {
+  if ((rhs > 0 && lhs > (kInt64Max - rhs)) ||
+      (rhs < 0 && lhs < (kInt64Min - rhs))) {
+    return false;
+  }
+  *result = lhs + rhs;
+  return true;
+}
+
+bool CheckedSub(int64_t lhs, int64_t rhs, int64_t* result) {
+  if ((rhs < 0 && lhs > (kInt64Max + rhs)) ||
+      (rhs > 0 && lhs < (kInt64Min + rhs))) {
+    return false;
+  }
+  *result = lhs - rhs;
+  return true;
+}
+
+bool CheckedMul(int64_t lhs, int64_t rhs, int64_t* result) {
+  if (lhs > 0) {
+    if ((rhs > 0 && lhs > (kInt64Max / rhs)) ||
+        (rhs < 0 && rhs < (kInt64Min / lhs))) {
+      return false;
+    }
+  } else if (lhs < 0) {
+    if ((rhs > 0 && lhs < (kInt64Min / rhs)) ||
+        (rhs < 0 && lhs < (kInt64Max / rhs))) {
+      return false;
+    }
+  }
+  *result = lhs * rhs;
+  return true;
+}
+
+Pass::Status CheckedExactDivide(IRContext* context, int64_t dividend,
+                                int64_t divisor, std::string_view name,
+                                int64_t* result) {
+  if (divisor == 0) {
+    return ShapeFailure(context,
+                        std::string(name) + " extent has a zero divisor");
+  }
+  if (dividend == kInt64Min && divisor == -1) {
+    return ShapeFailure(
+        context, std::string(name) + " extent division overflows int64_t");
+  }
+  if (dividend % divisor != 0) {
+    return ShapeFailure(context,
+                        std::string(name) + " extent is not evenly divisible");
+  }
+  *result = dividend / divisor;
+  return Pass::Status::SuccessWithoutChange;
+}
+
+Pass::Status CheckedOutputExtent(IRContext* context, std::string_view name,
+                                 int64_t input, int64_t kernel,
+                                 int64_t pad_before, int64_t pad_after,
+                                 int64_t dilation, int64_t stride,
+                                 int64_t* output) {
+  int64_t effective_kernel_minus_one;
+  int64_t padded_input;
+  int64_t numerator;
+  if (!CheckedSub(kernel, 1, &effective_kernel_minus_one) ||
+      !CheckedMul(effective_kernel_minus_one, dilation,
+                  &effective_kernel_minus_one) ||
+      !CheckedAdd(input, pad_before, &padded_input) ||
+      !CheckedAdd(padded_input, pad_after, &padded_input) ||
+      !CheckedSub(padded_input, effective_kernel_minus_one, &numerator) ||
+      !CheckedSub(numerator, 1, &numerator)) {
+    return ShapeFailure(context,
+                        std::string(name) + " arithmetic overflows int64_t");
+  }
+
+  int64_t quotient;
+  auto status = CheckedExactDivide(context, numerator, stride, name, &quotient);
+  if (status == Pass::Status::Failure) {
+    return status;
+  }
+  if (!CheckedAdd(quotient, 1, output)) {
+    return ShapeFailure(context,
+                        std::string(name) + " output extent overflows int64_t");
+  }
+  return ValidateOutputDimension(context, name, *output);
+}
+
+Pass::Status GetAxisConstant(IRContext* context, std::string_view op_name,
+                             uint32_t axis_id, uint32_t* axis) {
+  std::string error_msg;
+  const auto value = GetIntegerConstantValue(context, axis_id, 32, &error_msg);
+  if (!value.has_value()) {
+    return ShapeFailure(context,
+                        std::string(op_name) + " axis value " + error_msg);
+  }
+
+  *axis = static_cast<uint32_t>(value.value());
+  return Pass::Status::SuccessWithoutChange;
+}
+
+Pass::Status ValidateSpatialParameters(
+    IRContext* context, std::string_view op_name,
+    const std::vector<int32_t>& padding, const std::vector<int32_t>& stride,
+    const std::vector<int32_t>& dilation = {}) {
+  if (std::any_of(padding.begin(), padding.end(),
+                  [](int32_t value) { return value < 0; })) {
+    return ShapeFailure(
+        context, std::string(op_name) + " padding values must be non-negative");
+  }
+  if (std::any_of(stride.begin(), stride.end(),
+                  [](int32_t value) { return value <= 0; })) {
+    return ShapeFailure(
+        context,
+        std::string(op_name) + " stride values must be greater than zero");
+  }
+  if (std::any_of(dilation.begin(), dilation.end(),
+                  [](int32_t value) { return value <= 0; })) {
+    return ShapeFailure(context, std::string(op_name) +
+                                     " dilation values must be greater than "
+                                     "zero");
+  }
+  return Pass::Status::SuccessWithoutChange;
+}
