+Pass::Status ShapeGraphInstructionGatherOp(IRContext* context,
+                                           uint32_t values_id,
+                                           uint32_t indices_id,
+                                           std::vector<int64_t>* output_shape) {
+  auto values_shape = GetTensorShape(context, values_id);
+  if (!values_shape) {
+    return ShapeFailure(context, "Gather values shape must be known");
+  }
+  auto indices_shape = GetTensorShape(context, indices_id);
+  if (!indices_shape) {
+    return ShapeFailure(context, "Gather indices shape must be known");
+  }
+
+  if (values_shape.value().size() != 3) {
+    return ShapeFailure(context, "Gather values tensor must be rank 3");
+  }
+  if (indices_shape.value().size() != 2) {
+    return ShapeFailure(context, "Gather indices tensor must be rank 2");
+  }
+  auto N = values_shape.value()[0];
+  auto W = indices_shape.value()[1];
+  auto C = values_shape.value()[2];
+
+  *output_shape = {N, W, C};
+  return Pass::Status::SuccessWithoutChange;
+}
