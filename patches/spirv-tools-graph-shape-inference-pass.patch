+Pass::Status ShapeGraphInstructionArgmaxOp(IRContext* context,
+                                           uint32_t input_id, uint32_t axis_id,
+                                           std::vector<int64_t>* output_shape) {
+  uint32_t axis = 0;
+  if (GetAxisConstant(context, "Argmax", axis_id, &axis) ==
+      Pass::Status::Failure) {
+    return Pass::Status::Failure;
+  }
+
+  auto input_shape = GetTensorShape(context, input_id);
+  if (!input_shape) {
+    return ShapeFailure(context, "Argmax input shape must be known");
+  }
+
+  if (axis >= input_shape.value().size()) {
+    return ShapeFailure(context, "Axis outside of input tensor rank");
+  }
+
+  std::vector<int64_t> reduced_shape = input_shape.value();
+  reduced_shape.erase(reduced_shape.begin() + axis);
+
+  *output_shape = reduced_shape;
+  return Pass::Status::SuccessWithoutChange;
+}
