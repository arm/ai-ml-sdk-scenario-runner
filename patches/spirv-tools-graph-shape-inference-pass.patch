+typedef struct spv_graph_interface_shape {
+  // Descriptor set decoration of the graph interface tensor variable.
+  uint32_t descriptor_set;
+  // Binding decoration of the graph interface tensor variable.
+  uint32_t binding_id;
+  // Number of dimensions in |shape|.
+  uint32_t rank;
+  // Pointer to |rank| dimension sizes. Must be non-null if |rank| is nonzero.
+  const int64_t* shape;
+} spv_graph_interface_shape;
+
+// A callback that accepts graph outputs having both a statically known shape
+// and descriptor set/binding decorations. |output_shapes| and its shape
+// pointers are valid only for the duration of the callback.
+typedef void (*spv_graph_output_shape_consumer)(
+    void* user_data, size_t output_shape_count,
+    const spv_graph_interface_shape* output_shapes);
+
+// Registers a pass that attempts to shape graphs in the code.
+//
+// The pass supports direct OpTypeTensorARM graph interfaces and graph bodies
+// using TOSA.001000.1 or Arm.MotionEngine.100 extended instructions, plus
+// OpCompositeExtract for multi-output results. Graphs referenced by more than
+// one OpGraphEntryPointARM are not supported. Tensor shapes and attributes
+// needed to calculate output shapes must be ordinary static constants. The
+// pass validates requirements needed to calculate representable output shapes;
+// it does not replace dialect semantic validation.
+//
+// |interface_shapes| provides full shapes for graph input or output interface
+// tensors identified by descriptor set and binding. The list does not need an
+// entry for every graph interface. An input request is required only when
+// neither its interface variable nor an already-shaped graph type supplies its
+// shape. Output requests are optional checks against inferred output shapes.
+// Supplied entries must satisfy the following requirements:
+// * No duplicate descriptor-set/binding pairs.
+// * Each shape has |rank| > 0.
+// * Each shape has a non-null |shape| pointer to |rank| dimensions.
+// * Each dimension is in the range [1, UINT32_MAX].
+//
+// Returns false and does not register the pass if the C shape list cannot be
+// copied safely. Shape-entry validity is checked when the pass runs.
+// If |consumer| is non-null, it is called once after the pass succeeds with
+// graph outputs having both a statically known shape and descriptor set/binding
+// decorations. It is called with no outputs when none are reportable.
+SPIRV_TOOLS_EXPORT bool spvOptimizerRegisterGraphShapePass(
+    spv_optimizer_t* optimizer, const size_t num_interface_shapes,
+    const spv_graph_interface_shape* interface_shapes,
+    spv_graph_output_shape_consumer consumer, void* user_data);
+
 // Registers a pass specified by a flag in an optimizer object.
 SPIRV_TOOLS_EXPORT bool spvOptimizerRegisterPassFromFlag(
     spv_optimizer_t* optimizer, const char* flag);
