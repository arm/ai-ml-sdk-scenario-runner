+Pass::Status ShapeGraphInstructionDepthwiseConv2dOp(
+    IRContext* context, uint32_t pad_id, uint32_t stride_id,
+    uint32_t dilation_id, uint32_t input_id, uint32_t weights_id,
+    std::vector<int64_t>* output_shape) {
+  std::vector<int32_t> pad;
+  if (GetI32TensorConstantValues(context, "Depthwise Conv2D pad", pad_id, 4,
+                                 &pad) == Pass::Status::Failure) {
+    return Pass::Status::Failure;
+  }
+  int32_t pad_top = pad[0];
+  int32_t pad_bottom = pad[1];
+  int32_t pad_left = pad[2];
+  int32_t pad_right = pad[3];
+
+  std::vector<int32_t> stride;
+  if (GetI32TensorConstantValues(context, "Depthwise Conv2D stride", stride_id,
+                                 2, &stride) == Pass::Status::Failure) {
+    return Pass::Status::Failure;
+  }
+  int32_t stride_y = stride[0];
+  int32_t stride_x = stride[1];
+
+  std::vector<int32_t> dilation;
+  if (GetI32TensorConstantValues(context, "Depthwise Conv2D dilation",
+                                 dilation_id, 2,
+                                 &dilation) == Pass::Status::Failure) {
+    return Pass::Status::Failure;
+  }
+  int32_t dilation_y = dilation[0];
+  int32_t dilation_x = dilation[1];
+
+  auto input_shape = GetTensorShape(context, input_id);
+  if (!input_shape) {
+    return ShapeFailure(context, "Depthwise Conv2D input shape must be known");
+  }
+  if (input_shape.value().size() != 4) {
+    return ShapeFailure(context,
+                        "Depthwise Conv2D input tensor must be rank 4");
+  }
+
+  auto N = input_shape.value()[0];
+  auto IH = input_shape.value()[1];
+  auto IW = input_shape.value()[2];
+  auto C = input_shape.value()[3];
+
+  auto weights_shape = GetTensorShape(context, weights_id);
+  if (!weights_shape) {
+    return ShapeFailure(context,
+                        "Depthwise Conv2D weights shape must be known");
+  }
+  if (weights_shape.value().size() != 4) {
+    return ShapeFailure(context,
+                        "Depthwise Conv2D weights tensor must be rank 4");
+  }
+
+  auto KH = weights_shape.value()[0];
+  auto KW = weights_shape.value()[1];
+  auto M = weights_shape.value()[3];
+  int64_t output_channels;
+  if (!CheckedMul(C, M, &output_channels)) {
+    return ShapeFailure(
+        context,
+        "Depthwise Conv2D output channels arithmetic overflows int64_t");
+  }
+  if (ValidateOutputDimension(context, "Depthwise Conv2D output channels",
+                              output_channels) == Pass::Status::Failure) {
+    return Pass::Status::Failure;
+  }
+  if (ValidateSpatialParameters(context, "Depthwise Conv2D", pad, stride,
+                                dilation) == Pass::Status::Failure) {
+    return Pass::Status::Failure;
+  }
+
+  int64_t OH;
+  int64_t OW;
+  if (CheckedOutputExtent(context, "Depthwise Conv2D height", IH, KH, pad_top,
+                          pad_bottom, dilation_y, stride_y,
+                          &OH) == Pass::Status::Failure ||
+      CheckedOutputExtent(context, "Depthwise Conv2D width", IW, KW, pad_left,
+                          pad_right, dilation_x, stride_x,
+                          &OW) == Pass::Status::Failure) {
+    return Pass::Status::Failure;
+  }
+
+  *output_shape = {N, OH, OW, output_channels};
+  return Pass::Status::SuccessWithoutChange;
+}
