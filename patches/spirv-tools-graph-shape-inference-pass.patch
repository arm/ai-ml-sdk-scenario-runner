+Pass::Status ShapeGraphInstructionPadOp(IRContext* context, uint32_t input_id,
+                                        uint32_t padding_id,
+                                        std::vector<int64_t>* output_shape) {
+  auto input_shape = GetTensorShape(context, input_id);
+  if (!input_shape) {
+    return ShapeFailure(context, "Pad input shape must be known");
+  }
+  std::vector<int32_t> padding;
+  if (GetI32TensorConstantValues(context, "Pad padding", padding_id,
+                                 input_shape.value().size() * 2,
+                                 &padding) == Pass::Status::Failure) {
+    return Pass::Status::Failure;
+  }
+
+  output_shape->clear();
+  output_shape->reserve(input_shape.value().size());
+  for (size_t dim = 0; dim < input_shape.value().size(); ++dim) {
+    if (padding[2 * dim] < 0 || padding[2 * dim + 1] < 0) {
+      return ShapeFailure(context, "Pad padding values must be non-negative");
+    }
+    int64_t output_dim;
+    if (!CheckedAdd(input_shape.value()[dim], padding[2 * dim], &output_dim) ||
+        !CheckedAdd(output_dim, padding[2 * dim + 1], &output_dim)) {
+      return ShapeFailure(context, "Pad output dimension overflows int64_t");
+    }
+    if (ValidateOutputDimension(context, "Pad output", output_dim) ==
+        Pass::Status::Failure) {
+      return Pass::Status::Failure;
+    }
+    output_shape->push_back(output_dim);
+  }
+  return Pass::Status::SuccessWithoutChange;
+}
