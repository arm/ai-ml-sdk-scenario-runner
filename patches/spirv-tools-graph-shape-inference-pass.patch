+Pass::Status ShapeGraphInstructionSliceOp(IRContext* context, uint32_t size_id,
+                                          std::vector<int64_t>* output_shape) {
+  auto size_shape = GetTensorShape(context, size_id);
+  if (!size_shape) {
+    return ShapeFailure(context, "Slice size shape must be known");
+  }
+  if (size_shape.value().size() != 1) {
+    return ShapeFailure(context, "Slice size tensor must be rank 1");
+  }
+  size_t rank = static_cast<size_t>(size_shape.value()[0]);
+
+  std::vector<int32_t> size;
+  if (GetI32TensorConstantValues(context, "Slice size", size_id, rank, &size) ==
+      Pass::Status::Failure) {
+    return Pass::Status::Failure;
+  }
+
+  output_shape->clear();
+  output_shape->reserve(rank);
+  for (size_t dim = 0; dim < rank; ++dim) {
+    if (size[dim] <= 0) {
+      return ShapeFailure(context, "Slice size must be positive");
+    }
+    output_shape->push_back(size[dim]);
+  }
+
+  return Pass::Status::SuccessWithoutChange;
+}
