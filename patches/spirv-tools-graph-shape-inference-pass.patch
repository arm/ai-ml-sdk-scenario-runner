+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+"""Generates extended-instruction operand index constants."""
+
+import argparse
+import json
+import os
+import re
+
+
+def ensure_parent_dir(path):
+    directory = os.path.dirname(os.path.abspath(path))
+    if directory:
+        os.makedirs(directory, exist_ok=True)
+
+
+def identifier_fragment(name):
+    parts = re.split(r"[^0-9A-Za-z]+", name)
+    return "".join(
+        part[:1].upper() + part[1:].lower() for part in parts if part
+    )
+
+
+def has_numbered_input_group(operands):
+    return any(
+        re.match(r"input(0|[2-9][0-9]*)(_|$)", operand["name"])
+        for operand in operands
+    )
+
+
+def has_variadic_input1(operands):
+    return any(
+        operand["name"] == "input1" and operand.get("quantifier") == "*"
+        for operand in operands
+    )
+
+
+def normalize_operand_name(name, operands):
+    if (
+        not has_numbered_input_group(operands)
+        and not has_variadic_input1(operands)
+    ):
+        if name == "input1":
+            return "input"
+        if name.startswith("input1_"):
+            return "input" + name[len("input1"):]
+    return name
+
+
+def collect_operand_indices(grammar):
+    operand_indices = {}
+    for instruction in grammar["instructions"]:
+        opcode = instruction["opcode"]
+        opname = instruction["opname"]
+        operands = instruction.get("operands", [])
+        for operand_index, operand in enumerate(operands):
+            operand_name = normalize_operand_name(operand["name"], operands)
+            operand_indices.setdefault(operand_name, []).append(
+                (opcode, opname, operand_index)
+            )
+    return operand_indices
+
+
+def role_enumerator_name(operand_name):
+    return "k" + identifier_fragment(operand_name)
+
+
+def include_guard(output):
+    stem = os.path.basename(output)
+    name = re.sub(r"[^0-9A-Za-z]", "_", stem).upper()
+    return "SOURCE_OPT_" + name + "_"
+
+
+def generate_constants(grammar, grammar_path, namespace, guard):
+    operand_indices = collect_operand_indices(grammar)
+    lines = [
+        "// {}".format(notice)
+        for notice in grammar.get("copyright", [])
+    ]
+    if lines:
+        lines.append("")
+    lines.extend([
+        "// Generated by utils/generate_extinst_operand_constants.py from",
+        "// {}.".format(os.path.basename(grammar_path)),
+        "// Do not edit manually.",
+        "",
+        "#ifndef {}".format(guard),
+        "#define {}".format(guard),
+        "",
+        "#include <cstdint>",
+        "",
+        "namespace spvtools {",
+        "namespace opt {",
+        "namespace {} {{".format(namespace),
+        "",
+        "// OpExtInst in-operands 0 and 1 are the set id and opcode.",
+        "constexpr uint32_t kExtInstSetId = 0;",
+        "constexpr uint32_t kExtInstOpcode = 1;",
+        "constexpr uint32_t kExtInstOperandStart = 2;",
+        "constexpr uint32_t kInvalidOperand = ~uint32_t{0};",
+        "",
+        "enum class OperandRole {",
+    ])
+
+    for operand_name in sorted(operand_indices):
+        lines.append("  {},".format(role_enumerator_name(operand_name)))
+    lines.append("};")
+    lines.append("")
+
+    lines.append("inline const char* OperandRoleName(OperandRole role) {")
+    lines.append("  switch (role) {")
+    for operand_name in sorted(operand_indices):
+        lines.append(
+            '    case OperandRole::{}:'.format(
+                role_enumerator_name(operand_name)
+            )
+        )
+        lines.append('      return "{}";'.format(operand_name))
+    lines.append("  }")
+    lines.append('  return "unknown";')
+    lines.append("}")
+    lines.append("")
+
+    lines.append(
+        "inline uint32_t GetOperandIndex(uint32_t extinst_opcode, "
+        "OperandRole role) {"
+    )
+    lines.append("  switch (role) {")
+    for operand_name in sorted(operand_indices):
+        lines.append(
+            "    case OperandRole::{}:".format(
+                role_enumerator_name(operand_name)
+            )
+        )
+        lines.append("      switch (extinst_opcode) {")
+        for opcode, opname, operand_index in operand_indices[operand_name]:
+            lines.append("        case {}:  // {}".format(opcode, opname))
+            lines.append(
+                "          return kExtInstOperandStart + {};".format(
+                    operand_index
+                )
+            )
+        lines.append("        default:")
+        lines.append("          return kInvalidOperand;")
+        lines.append("      }")
+    lines.append("  }")
+    lines.append("  return kInvalidOperand;")
+    lines.append("}")
+    lines.append("")
+
+    lines.extend(
+        [
+            "}}  // namespace {}".format(namespace),
+            "}  // namespace opt",
+            "}  // namespace spvtools",
+            "",
+            "#endif  // {}".format(guard),
+            "",
+        ]
+    )
+    return "\n".join(lines)
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument(
+        "--grammar", required=True, help="extended-instruction grammar JSON"
+    )
+    parser.add_argument("--output", required=True, help="output header path")
+    parser.add_argument(
+        "--namespace", required=True, help="namespace for generated constants"
+    )
+    args = parser.parse_args()
+
+    with open(args.grammar, encoding="utf-8") as grammar_file:
+        grammar = json.load(grammar_file)
+
+    ensure_parent_dir(args.output)
+    with open(args.output, "w", encoding="utf-8") as output_file:
+        output_file.write(
+            generate_constants(
+                grammar,
+                args.grammar,
+                args.namespace,
+                include_guard(args.output),
+            )
+        )
+
+
+if __name__ == "__main__":
+    main()
