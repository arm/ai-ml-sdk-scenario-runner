+Pass::Status ShapeGraphInstructionReduceOps(
+    IRContext* context, uint32_t input_id, uint32_t axis_id,
+    std::vector<int64_t>* output_shape) {
+  uint32_t axis = 0;
+  if (GetAxisConstant(context, "Reduce", axis_id, &axis) ==
+      Pass::Status::Failure) {
