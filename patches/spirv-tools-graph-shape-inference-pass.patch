+Pass::Status ShapeGraphInstructionTOSA(IRContext* context, Instruction* inst) {
+  TosaOperandReader tosa_operands(context, inst);
+  if (tosa_operands.ReadOpcode() == Pass::Status::Failure) {
+    return Pass::Status::Failure;
+  }
+  uint32_t tosaop = tosa_operands.opcode();
+
+  std::vector<int64_t> output_shape;
+
+  switch (tosaop) {
+    case tosa010::TOSAARGMAX: {
+      uint32_t input_id = 0;
+      uint32_t axis_id = 0;
+      if (tosa_operands.ReadOperands({{TosaOperandRole::kInput, &input_id},
+                                      {TosaOperandRole::kAxis, &axis_id}}) ==
+          Pass::Status::Failure) {
+        return Pass::Status::Failure;
+      }
+      auto status = ShapeGraphInstructionArgmaxOp(context, input_id, axis_id,
+                                                  &output_shape);
+      if (status == Pass::Status::Failure) {
+        return status;
+      }
+      break;
+    }
+    case tosa010::TOSAAVG_POOL2D:
+    case tosa010::TOSAMAX_POOL2D: {
+      uint32_t kernel_id = 0;
+      uint32_t stride_id = 0;
+      uint32_t pad_id = 0;
+      uint32_t input_id = 0;
+      if (tosa_operands.ReadOperands({{TosaOperandRole::kKernel, &kernel_id},
+                                      {TosaOperandRole::kStride, &stride_id},
+                                      {TosaOperandRole::kPad, &pad_id},
+                                      {TosaOperandRole::kInput, &input_id}}) ==
+          Pass::Status::Failure) {
+        return Pass::Status::Failure;
+      }
+      auto status = ShapeGraphInstructionAvgMaxPool2dOps(
+          context, kernel_id, stride_id, pad_id, input_id, &output_shape);
+      if (status == Pass::Status::Failure) {
+        return status;
+      }
+      break;
+    }
+    case tosa010::TOSAFFT2D: {
+      uint32_t input_real_id = 0;
+      if (tosa_operands.ReadOperands(
+              {{TosaOperandRole::kInputReal, &input_real_id}}) ==
+          Pass::Status::Failure) {
+        return Pass::Status::Failure;
+      }
+      std::vector<std::vector<int64_t> > output_shapes;
+      auto status =
+          ShapeGraphInstructionFFT2dOp(context, input_real_id, &output_shapes);
+      if (status == Pass::Status::Failure) {
+        return status;
+      }
+      return ShapeGraphInstructionMultiOutput(context, inst, output_shapes);
+    }
+    case tosa010::TOSARFFT2D: {
+      uint32_t input_real_id = 0;
+      if (tosa_operands.ReadOperands(
+              {{TosaOperandRole::kInputReal, &input_real_id}}) ==
+          Pass::Status::Failure) {
+        return Pass::Status::Failure;
+      }
+      std::vector<std::vector<int64_t> > output_shapes;
+      auto status =
+          ShapeGraphInstructionRFFT2dOp(context, input_real_id, &output_shapes);
+      if (status == Pass::Status::Failure) {
+        return status;
+      }
+      return ShapeGraphInstructionMultiOutput(context, inst, output_shapes);
+    }
+    case tosa010::TOSAABS:
+    case tosa010::TOSABITWISE_NOT:
+    case tosa010::TOSACEIL:
+    case tosa010::TOSACLZ:
+    case tosa010::TOSACOS:
+    case tosa010::TOSAEXP:
+    case tosa010::TOSAFLOOR:
+    case tosa010::TOSALOG:
+    case tosa010::TOSALOGICAL_NOT:
+    case tosa010::TOSANEGATE:
+    case tosa010::TOSARECIPROCAL:
+    case tosa010::TOSARSQRT:
+    case tosa010::TOSASIN:
+    case tosa010::TOSACAST:
+    case tosa010::TOSARESCALE:
+    case tosa010::TOSAERF:
+    case tosa010::TOSASIGMOID:
+    case tosa010::TOSATANH:
+    case tosa010::TOSACLAMP:
+    case tosa010::TOSATABLE: {
+      uint32_t input_id = 0;
+      if (tosa_operands.ReadOperands({{TosaOperandRole::kInput, &input_id}}) ==
+          Pass::Status::Failure) {
+        return Pass::Status::Failure;
+      }
+      auto status =
+          ShapeGraphInstructionMatchOutput(context, input_id, &output_shape);
+      if (status == Pass::Status::Failure) {
+        return status;
+      }
+      break;
+    }
+    case tosa010::TOSAADD:
+    case tosa010::TOSAARITHMETIC_RIGHT_SHIFT:
+    case tosa010::TOSABITWISE_AND:
+    case tosa010::TOSABITWISE_OR:
+    case tosa010::TOSABITWISE_XOR:
+    case tosa010::TOSAINTDIV:
+    case tosa010::TOSALOGICAL_AND:
+    case tosa010::TOSALOGICAL_LEFT_SHIFT:
+    case tosa010::TOSALOGICAL_RIGHT_SHIFT:
+    case tosa010::TOSALOGICAL_OR:
+    case tosa010::TOSALOGICAL_XOR:
+    case tosa010::TOSAMAXIMUM:
+    case tosa010::TOSAMINIMUM:
+    case tosa010::TOSAMUL:
+    case tosa010::TOSAPOW:
+    case tosa010::TOSASUB:
+    case tosa010::TOSAEQUAL:
+    case tosa010::TOSAGREATER:
+    case tosa010::TOSAGREATER_EQUAL: {
+      uint32_t input1_id = 0;
+      uint32_t input2_id = 0;
+      if (tosa_operands.ReadOperands({{TosaOperandRole::kInput1, &input1_id},
+                                      {TosaOperandRole::kInput2,
+                                       &input2_id}}) == Pass::Status::Failure) {
+        return Pass::Status::Failure;
+      }
+      auto status = ShapeGraphInstructionMatchOutputWithCheck(
+          context, input1_id, input2_id, &output_shape);
+      if (status == Pass::Status::Failure) {
+        return status;
+      }
+      break;
+    }
+    case tosa010::TOSAREDUCE_ALL:
+    case tosa010::TOSAREDUCE_ANY:
+    case tosa010::TOSAREDUCE_MAX:
+    case tosa010::TOSAREDUCE_MIN:
+    case tosa010::TOSAREDUCE_PRODUCT:
+    case tosa010::TOSAREDUCE_SUM: {
+      uint32_t input_id = 0;
+      uint32_t axis_id = 0;
+      if (tosa_operands.ReadOperands({{TosaOperandRole::kInput, &input_id},
+                                      {TosaOperandRole::kAxis, &axis_id}}) ==
+          Pass::Status::Failure) {
+        return Pass::Status::Failure;
+      }
+      auto status = ShapeGraphInstructionReduceOps(context, input_id, axis_id,
+                                                   &output_shape);
+      if (status == Pass::Status::Failure) {
+        return status;
+      }
+      break;
+    }
+    case tosa010::TOSASELECT: {
+      uint32_t input1_id = 0;
+      uint32_t input2_id = 0;
+      uint32_t input3_id = 0;
+      if (tosa_operands.ReadOperands({{TosaOperandRole::kInput1, &input1_id},
+                                      {TosaOperandRole::kInput2, &input2_id},
+                                      {TosaOperandRole::kInput3,
+                                       &input3_id}}) == Pass::Status::Failure) {
+        return Pass::Status::Failure;
+      }
+      auto status = ShapeGraphInstructionSelectOp(context, input1_id, input2_id,
+                                                  input3_id, &output_shape);
+      if (status == Pass::Status::Failure) {
+        return status;
+      }
+      break;
+    }
+    case tosa010::TOSASCATTER: {
+      uint32_t values_in_id = 0;
+      if (tosa_operands.ReadOperands(
+              {{TosaOperandRole::kValuesIn, &values_in_id}}) ==
+          Pass::Status::Failure) {
+        return Pass::Status::Failure;
+      }
+      auto status = ShapeGraphInstructionMatchOutput(context, values_in_id,
+                                                     &output_shape);
+      if (status == Pass::Status::Failure) {
+        return status;
+      }
+      break;
+    }
+    case tosa010::TOSACONV2D: {
+      uint32_t pad_id = 0;
+      uint32_t stride_id = 0;
+      uint32_t dilation_id = 0;
+      uint32_t input_id = 0;
+      uint32_t weight_id = 0;
+      if (tosa_operands.ReadOperands(
+              {{TosaOperandRole::kPad, &pad_id},
+               {TosaOperandRole::kStride, &stride_id},
+               {TosaOperandRole::kDilation, &dilation_id},
+               {TosaOperandRole::kInput, &input_id},
+               {TosaOperandRole::kWeight, &weight_id}}) ==
+          Pass::Status::Failure) {
+        return Pass::Status::Failure;
+      }
+      auto status =
+          ShapeGraphInstructionConv2dOp(context, pad_id, stride_id, dilation_id,
+                                        input_id, weight_id, &output_shape);
+      if (status == Pass::Status::Failure) {
+        return status;
+      }
+      break;
+    }
+    case tosa010::TOSACONV3D: {
+      uint32_t pad_id = 0;
+      uint32_t stride_id = 0;
+      uint32_t dilation_id = 0;
+      uint32_t input_id = 0;
+      uint32_t weight_id = 0;
+      if (tosa_operands.ReadOperands(
+              {{TosaOperandRole::kPad, &pad_id},
+               {TosaOperandRole::kStride, &stride_id},
+               {TosaOperandRole::kDilation, &dilation_id},
+               {TosaOperandRole::kInput, &input_id},
+               {TosaOperandRole::kWeight, &weight_id}}) ==
+          Pass::Status::Failure) {
+        return Pass::Status::Failure;
+      }
+      auto status =
+          ShapeGraphInstructionConv3dOp(context, pad_id, stride_id, dilation_id,
+                                        input_id, weight_id, &output_shape);
+      if (status == Pass::Status::Failure) {
+        return status;
+      }
+      break;
+    }
+    case tosa010::TOSAMATMUL: {
+      uint32_t input_a_id = 0;
+      uint32_t input_b_id = 0;
+      if (tosa_operands.ReadOperands({{TosaOperandRole::kA, &input_a_id},
+                                      {TosaOperandRole::kB, &input_b_id}}) ==
+          Pass::Status::Failure) {
+        return Pass::Status::Failure;
+      }
+      auto status = ShapeGraphInstructionMatmulOp(context, input_a_id,
+                                                  input_b_id, &output_shape);
+      if (status == Pass::Status::Failure) {
+        return status;
+      }
+      break;
+    }
+    case tosa010::TOSADEPTHWISE_CONV2D: {
+      uint32_t pad_id = 0;
+      uint32_t stride_id = 0;
+      uint32_t dilation_id = 0;
+      uint32_t input_id = 0;
+      uint32_t weight_id = 0;
+      if (tosa_operands.ReadOperands(
+              {{TosaOperandRole::kPad, &pad_id},
+               {TosaOperandRole::kStride, &stride_id},
+               {TosaOperandRole::kDilation, &dilation_id},
+               {TosaOperandRole::kInput, &input_id},
+               {TosaOperandRole::kWeight, &weight_id}}) ==
+          Pass::Status::Failure) {
+        return Pass::Status::Failure;
+      }
+      auto status = ShapeGraphInstructionDepthwiseConv2dOp(
+          context, pad_id, stride_id, dilation_id, input_id, weight_id,
+          &output_shape);
+      if (status == Pass::Status::Failure) {
+        return status;
+      }
+      break;
+    }
+    case tosa010::TOSATRANSPOSE_CONV2D: {
+      uint32_t out_pad_id = 0;
+      uint32_t stride_id = 0;
+      uint32_t input_id = 0;
+      uint32_t weight_id = 0;
+      if (tosa_operands.ReadOperands({{TosaOperandRole::kOutPad, &out_pad_id},
+                                      {TosaOperandRole::kStride, &stride_id},
+                                      {TosaOperandRole::kInput, &input_id},
+                                      {TosaOperandRole::kWeight,
+                                       &weight_id}}) == Pass::Status::Failure) {
+        return Pass::Status::Failure;
+      }
+      auto status = ShapeGraphInstructionTransposeConv2dOp(
+          context, out_pad_id, stride_id, input_id, weight_id, &output_shape);
+      if (status == Pass::Status::Failure) {
+        return status;
+      }
+      break;
+    }
+    case tosa010::TOSARESIZE: {
+      uint32_t input_id = 0;
+      uint32_t scale_id = 0;
+      uint32_t offset_id = 0;
+      uint32_t border_id = 0;
+      if (tosa_operands.ReadOperands({{TosaOperandRole::kInput, &input_id},
+                                      {TosaOperandRole::kScale, &scale_id},
+                                      {TosaOperandRole::kOffset, &offset_id},
+                                      {TosaOperandRole::kBorder,
+                                       &border_id}}) == Pass::Status::Failure) {
+        return Pass::Status::Failure;
+      }
+      auto status = ShapeGraphInstructionResizeOp(
+          context, input_id, scale_id, offset_id, border_id, &output_shape);
+      if (status == Pass::Status::Failure) {
+        return status;
+      }
+      break;
+    }
+    case tosa010::TOSACONCAT: {
+      uint32_t axis_id = 0;
+      std::vector<uint32_t> input_ids;
+      if (tosa_operands.ReadOperands({{TosaOperandRole::kAxis, &axis_id}}) ==
+              Pass::Status::Failure ||
+          tosa_operands.ReadVariadic(TosaOperandRole::kInput1, &input_ids) ==
+              Pass::Status::Failure) {
+        return Pass::Status::Failure;
+      }
+      auto status = ShapeGraphInstructionConcatOp(context, axis_id, input_ids,
+                                                  &output_shape);
+      if (status == Pass::Status::Failure) {
+        return status;
+      }
+      break;
+    }
+    case tosa010::TOSARESHAPE: {
+      uint32_t shape_id = 0;
+      if (tosa_operands.ReadOperands({{TosaOperandRole::kShape, &shape_id}}) ==
+          Pass::Status::Failure) {
+        return Pass::Status::Failure;
+      }
+      auto status =
+          ShapeGraphInstructionReshapeOp(context, shape_id, &output_shape);
+      if (status == Pass::Status::Failure) {
+        return status;
+      }
+      break;
+    }
+    case tosa010::TOSAREVERSE: {
+      uint32_t input_id = 0;
+      if (tosa_operands.ReadOperands({{TosaOperandRole::kInput, &input_id}}) ==
+          Pass::Status::Failure) {
+        return Pass::Status::Failure;
+      }
+      auto status =
+          ShapeGraphInstructionReverseOp(context, input_id, &output_shape);
+      if (status == Pass::Status::Failure) {
+        return status;
+      }
+      break;
+    }
+    case tosa010::TOSAGATHER: {
+      uint32_t values_id = 0;
+      uint32_t indices_id = 0;
+      if (tosa_operands.ReadOperands(
+              {{TosaOperandRole::kValues, &values_id},
+               {TosaOperandRole::kIndices, &indices_id}}) ==
+          Pass::Status::Failure) {
+        return Pass::Status::Failure;
+      }
+      auto status = ShapeGraphInstructionGatherOp(context, values_id,
+                                                  indices_id, &output_shape);
+      if (status == Pass::Status::Failure) {
+        return status;
+      }
+      break;
+    }
+    case tosa010::TOSASLICE: {
+      uint32_t size_id = 0;
+      if (tosa_operands.ReadOperands({{TosaOperandRole::kSize, &size_id}}) ==
+          Pass::Status::Failure) {
+        return Pass::Status::Failure;
+      }
+      auto status =
+          ShapeGraphInstructionSliceOp(context, size_id, &output_shape);
+      if (status == Pass::Status::Failure) {
+        return status;
+      }
+      break;
+    }
+    case tosa010::TOSATRANSPOSE: {
+      uint32_t perms_id = 0;
+      uint32_t input_id = 0;
+      if (tosa_operands.ReadOperands({{TosaOperandRole::kPerms, &perms_id},
+                                      {TosaOperandRole::kInput, &input_id}}) ==
+          Pass::Status::Failure) {
+        return Pass::Status::Failure;
+      }
+      auto status = ShapeGraphInstructionTransposeOp(context, perms_id,
+                                                     input_id, &output_shape);
+      if (status == Pass::Status::Failure) {
+        return status;
+      }
+      break;
+    }
+    case tosa010::TOSAPAD: {
+      uint32_t input_id = 0;
+      uint32_t padding_id = 0;
+      if (tosa_operands.ReadOperands(
+              {{TosaOperandRole::kInput, &input_id},
+               {TosaOperandRole::kPadding, &padding_id}}) ==
+          Pass::Status::Failure) {
+        return Pass::Status::Failure;
+      }
+      auto status = ShapeGraphInstructionPadOp(context, input_id, padding_id,
+                                               &output_shape);
+      if (status == Pass::Status::Failure) {
+        return status;
+      }
+      break;
+    }
+    case tosa010::TOSATILE: {
+      uint32_t input_id = 0;
+      uint32_t multiples_id = 0;
+      if (tosa_operands.ReadOperands(
+              {{TosaOperandRole::kInput, &input_id},
+               {TosaOperandRole::kMultiples, &multiples_id}}) ==
+          Pass::Status::Failure) {
+        return Pass::Status::Failure;
+      }
+      auto status = ShapeGraphInstructionTileOp(context, input_id, multiples_id,
+                                                &output_shape);
+      if (status == Pass::Status::Failure) {
+        return status;
+      }
+      break;
+    }
+    default:
+      return ShapeFailure(context, "Unhandled TOSA operator");
+  }
+
+  // TensorARM represents a TOSA rank-0 result as shape [1].
+  if (output_shape.empty()) {
+    output_shape.push_back(1);
+  }
+  return ShapeGraphInstructionSingleOutput(context, inst, output_shape);
+}
+
+}  // namespace opt
+}  // namespace spvtools
