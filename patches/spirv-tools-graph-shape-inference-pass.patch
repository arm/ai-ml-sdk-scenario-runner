+// Handles the unsigned-char cast required by std::isspace.
+bool IsSpace(char ch) {
+  return std::isspace(static_cast<unsigned char>(ch)) != 0;
+}
+
+// Skips whitespace at the current parser cursor.
+const char* SkipWhitespace(const char* str) {
+  while (*str != '\0' && IsSpace(*str)) {
+    ++str;
+  }
+  return str;
+}
+
+// Returns true if the given char is ':', ',', '\0' or considered as blank space
+// (i.e.: '\n', '\r', '\v', '\t', '\f' and ' ').
+bool IsSeparator(char ch) { return std::strchr(":,\0", ch) || IsSpace(ch); }
+
+// Parses a number up to the next separator and returns the separator position.
+template <typename T>
+const char* ParseNumberUntilSeparator(const char* str, T* number) {
+  const char* number_begin = str;
+  while (!IsSeparator(*str)) str++;
+  const char* number_end = str;
+  std::string number_in_str(number_begin, number_end - number_begin);
+  if (!utils::ParseNumber(number_in_str.c_str(), number)) {
+    return nullptr;
+  }
+  return str;
+}
+
+// Parses a numeric token and leaves |str| pointing at the following separator.
+template <typename T>
+bool ParseNumberToken(const char*& str, T* number, std::string_view error,
+                      std::string* error_msg) {
+  str = ParseNumberUntilSeparator(str, number);
+  if (str == nullptr) {
+    SetError(error_msg, error);
+    return false;
+  }
+  return true;
+}
+
+// Consumes |expected| from the current cursor position.
+bool ConsumeChar(const char*& str, char expected, std::string_view error,
+                 std::string* error_msg) {
+  if (*str != expected) {
+    SetError(error_msg, error);
+    return false;
+  }
+  ++str;
+  return true;
+}
+
+// Parses one <descriptor set>:<binding>:<dim[,dim...]> shape request.
+bool ParseInterfaceShape(const char*& str, GraphInterfaceShape* interface_shape,
+                         std::string* error_msg) {
+  uint32_t descriptor_set = 0;
+  if (!ParseNumberToken(str, &descriptor_set, "Invalid descriptor set",
+                        error_msg)) {
+    return false;
+  }
+  if (!ConsumeChar(str, ':', "Expected ':' after descriptor set", error_msg)) {
+    return false;
+  }
+
+  uint32_t binding = 0;
+  if (!ParseNumberToken(str, &binding, "Invalid binding", error_msg)) {
+    return false;
+  }
+  if (!ConsumeChar(str, ':', "Expected ':' after binding", error_msg)) {
+    return false;
+  }
+
+  std::vector<int64_t> shape;
+  while (true) {
+    int64_t dim = 0;
+    if (!ParseNumberToken(str, &dim, "Invalid shape dimension", error_msg)) {
+      return false;
+    }
+    shape.push_back(dim);
+
+    if (*str == ',') {
+      ++str;
+      if (IsSeparator(*str)) {
+        SetError(error_msg, "Expected shape dimension after ','");
+        return false;
+      }
+      continue;
+    }
+    if (*str == '\0' || IsSpace(*str)) {
+      break;
+    }
+
+    SetError(error_msg, "Expected ',' or whitespace after shape dimension");
+    return false;
+  }
+
+  *interface_shape = {descriptor_set, binding, std::move(shape)};
+  return true;
+}
+
+Pass::Status ShapeGraphCompositeExtract(IRContext* context, Instruction* inst) {
+  if (inst->NumInOperands() == 0) {
+    return ShapeFailure(context,
+                        "OpCompositeExtract is missing composite operand");
+  }
+  auto composite_id = inst->GetSingleWordInOperand(0);
+  auto composite_inst = context->get_def_use_mgr()->GetDef(composite_id);
+  if (composite_inst == nullptr) {
+    return ShapeFailure(context,
+                        "OpCompositeExtract composite id is not defined");
+  }
+
+  auto composite_type =
+      context->get_type_mgr()->GetType(composite_inst->type_id());
+  if (composite_type == nullptr) {
+    return ShapeFailure(context,
+                        "OpCompositeExtract composite type is not known");
+  }
+  if (inst->NumInOperands() != 2) {
+    return ShapeFailure(
+        context,
+        "Graph shape pass only supports OpCompositeExtract with one index");
+  }
+
+  const uint32_t member_index = inst->GetSingleWordInOperand(1);
+  const auto* struct_type = composite_type->AsStruct();
+  if (struct_type == nullptr) {
+    return ShapeFailure(context,
+                        "OpCompositeExtract composite must be a struct type");
+  }
+  if (member_index >= struct_type->element_types().size()) {
+    return ShapeFailure(context, "OpCompositeExtract member index " +
+                                     std::to_string(member_index) +
+                                     " is out of range");
+  }
+  const auto* member_type =
+      context->get_type_mgr()->GetMemberType(composite_type, {member_index});
+  if (member_type->AsTensorARM() == nullptr) {
+    return ShapeFailure(context,
+                        "OpCompositeExtract member must be a tensor type");
+  }
+  auto member_type_id =
+      context->get_type_mgr()->GetTypeInstruction(member_type);
+  if (member_type_id == 0) {
+    return ShapeFailure(context,
+                        "OpCompositeExtract member type has no type id");
+  }
+  auto existing_type_id = inst->type_id();
+  if (member_type_id == existing_type_id) {
+    return Pass::Status::SuccessWithoutChange;
+  }
+
+  inst->SetResultType(member_type_id);
+  return Pass::Status::SuccessWithChange;
+}
+
+std::string FormatDSB(const std::pair<uint32_t, uint32_t>& dsb) {
+  return "descriptor set " + std::to_string(dsb.first) + ", binding " +
+         std::to_string(dsb.second);
+}
+
+std::string FormatShape(const std::vector<int64_t>& shape) {
+  std::ostringstream stream;
+  stream << "[";
+  const char* separator = "";
+  for (int64_t dim : shape) {
+    stream << separator << dim;
+    separator = ", ";
+  }
+  stream << "]";
+  return stream.str();
+}
+
+std::string FormatOptionalDSB(
+    const std::optional<std::pair<uint32_t, uint32_t>>& dsb) {
+  if (!dsb.has_value()) return "no descriptor set/binding";
+  return FormatDSB(dsb.value());
+}
+
+std::string FormatIds(const std::vector<uint32_t>& ids) {
+  std::ostringstream stream;
+  const char* separator = "";
+  for (uint32_t id : ids) {
+    stream << separator << id;
+    separator = ", ";
+  }
+  return stream.str();
+}
+
+}  // namespace
+
+// External graph-shape interface adapters.
+bool CopyGraphInterfaceShapes(
+    size_t num_interface_shapes,
+    const spv_graph_interface_shape* interface_shape_inputs,
+    std::vector<GraphInterfaceShape>* interface_shapes,
+    std::string* error_msg) {
+  if (interface_shapes == nullptr) {
+    SetError(error_msg, "interface_shapes output must not be null");
+    return false;
+  }
+  interface_shapes->clear();
+
+  if (num_interface_shapes > 0 && interface_shape_inputs == nullptr) {
+    SetError(error_msg,
+             "interface_shapes must not be null when num_interface_shapes is "
+             "nonzero");
+    return false;
+  }
+
+  interface_shapes->reserve(num_interface_shapes);
+  for (size_t i = 0; i < num_interface_shapes; ++i) {
+    const auto& interface_shape_input = interface_shape_inputs[i];
+    if (interface_shape_input.rank > 0 &&
+        interface_shape_input.shape == nullptr) {
+      SetError(error_msg,
+               "Shape pointer for descriptor set " +
+                   std::to_string(interface_shape_input.descriptor_set) +
+                   ", binding " +
+                   std::to_string(interface_shape_input.binding_id) +
+                   " must not be null");
+      return false;
+    }
+
+    std::vector<int64_t> shape;
+    if (interface_shape_input.rank > 0) {
+      shape.assign(interface_shape_input.shape,
+                   interface_shape_input.shape + interface_shape_input.rank);
+    }
+    interface_shapes->push_back({interface_shape_input.descriptor_set,
+                                 interface_shape_input.binding_id,
+                                 std::move(shape)});
+  }
+
+  return true;
+}
+
+std::unique_ptr<std::vector<GraphInterfaceShape>>
+GraphShapePass::ParseInterfaceTensorShapesString(const char* str,
+                                                 std::string* error_msg) {
+  if (str == nullptr) {
+    SetError(error_msg, "Expected a shape list");
+    return nullptr;
+  }
+
+  str = SkipWhitespace(str);
+  if (*str == '\0') {
+    SetError(error_msg, "Expected a shape list");
+    return nullptr;
+  }
+
+  // Parse entries of the form:
+  //   descriptor_set:binding:dim[,dim...] [descriptor_set:binding:dim...]
+  auto interface_tensor_shapes = MakeUnique<std::vector<GraphInterfaceShape>>();
+  while (*str != '\0') {
+    GraphInterfaceShape interface_shape;
+    if (!ParseInterfaceShape(str, &interface_shape, error_msg)) {
+      return nullptr;
+    }
+    interface_tensor_shapes->push_back(std::move(interface_shape));
+    str = SkipWhitespace(str);
+  }
+
+  return interface_tensor_shapes;
+}
+
+Pass::Status GraphShapePass::ValidateAndBuildInterfaceTensorShapeMap(
+    MapOfInterfaceTensorShapes* interface_shape_map) const {
+  auto& shapes = *interface_shape_map;
+  shapes.clear();
+
+  for (const auto& interface_shape : interface_shape_requests_) {
+    const auto dsb =
+        std::make_pair(interface_shape.descriptor_set, interface_shape.binding);
+
+    if (shapes.find(dsb) != shapes.end()) {
+      // A descriptor-set/binding pair must identify at most one requested
+      // shape.
+      return ShapeFailure(context(),
+                          "Duplicate shape entry for descriptor set " +
+                              std::to_string(interface_shape.descriptor_set) +
+                              ", binding " +
+                              std::to_string(interface_shape.binding));
+    }
+
+    // Input shapes must be full static tensor shapes representable in SPIR-V.
+    const auto& shape = interface_shape.shape;
+    if (shape.empty()) {
+      return ShapeFailure(context(), "Shape for " + FormatDSB(dsb) +
+                                         " has rank 0; rank must be greater "
+                                         "than zero");
+    }
+
+    for (int64_t dim : shape) {
+      if (dim <= 0 || dim > std::numeric_limits<uint32_t>::max()) {
+        return ShapeFailure(context(), "Shape " + FormatShape(shape) + " for " +
+                                           FormatDSB(dsb) +
+                                           " contains dimension " +
+                                           std::to_string(dim) +
+                                           "; dimensions must be in the range "
+                                           "[1, UINT32_MAX]");
+      }
+    }
+
+    shapes.emplace(dsb, shape);
+  }
+
+  return Status::SuccessWithoutChange;
+}
+
+Pass::Status GraphShapePass::ValidateInterfaceTensorShapeResources(
+    const MapOfInterfaceTensorShapes& interface_shape_map) const {
+  const auto& shapes = interface_shape_map;
+  std::map<std::pair<uint32_t, uint32_t>, std::vector<uint32_t>> vars_by_dsb;
+
+  for (const auto& inst : context()->types_values()) {
+    if (inst.opcode() != spv::Op::OpVariable) continue;
+    auto dsb = GetDSBForVar(context(), inst.result_id());
+    // Only track resources the user supplied shapes for; unrelated resources do
+    // not affect this pass.
+    if (!dsb.has_value() || shapes.count(dsb.value()) == 0) {
+      continue;
+    }
+    vars_by_dsb[dsb.value()].push_back(inst.result_id());
+  }
+
+  for (const auto& shape_entry : shapes) {
+    const auto& dsb = shape_entry.first;
+    auto var_ids = vars_by_dsb.find(dsb);
+    if (var_ids == vars_by_dsb.end()) {
+      return ShapeFailure(context(),
+                          "No OpVariable resource found for " + FormatDSB(dsb));
+    }
+    if (var_ids->second.size() > 1) {
+      return ShapeFailure(context(),
+                          "Multiple OpVariable resources found for " +
+                              FormatDSB(dsb) + ": ids are " +
+                              FormatIds(var_ids->second));
+    }
+
+    uint32_t var_id = var_ids->second.front();
+    auto var_inst = context()->get_def_use_mgr()->GetDef(var_id);
+    if (var_inst == nullptr) {
+      return ShapeFailure(context(), "OpVariable " + std::to_string(var_id) +
+                                         " for " + FormatDSB(dsb) +
+                                         " is not defined");
+    }
+    if (GetTensorVariableType(context(), var_id) == nullptr) {
+      return ShapeFailure(
+          context(), "User-supplied shape for " + FormatDSB(dsb) +
+                         " refers to OpVariable " + std::to_string(var_id) +
+                         ", but its pointee type is not OpTypeTensorARM");
+    }
+  }
+
+  return Status::SuccessWithoutChange;
+}
+
+Pass::Status GraphShapePass::ValidateGraphEntryPointTopology() const {
+  // Each graph must be owned by a single entry point.
+  std::map<uint32_t, uint32_t> graph_entry_point_counts;
+  for (const auto& entry_point : context()->module()->graph_entry_points()) {
+    if (entry_point.NumInOperands() == 0) {
+      return ShapeFailure(context(),
+                          "OpGraphEntryPointARM is missing graph operand");
+    }
+    graph_entry_point_counts[entry_point.GetSingleWordInOperand(0)]++;
+  }
+
+  for (const auto& [graph_id, entry_point_count] : graph_entry_point_counts) {
+    if (entry_point_count > 1) {
+      return ShapeFailure(context(),
+                          "Graph shape pass does not support shared graphs: "
+                          "graph " +
+                              std::to_string(graph_id) + " is referenced by " +
+                              std::to_string(entry_point_count) +
+                              " OpGraphEntryPointARM instructions.");
+    }
+  }
+
+  return Status::SuccessWithoutChange;
+}
+
+static bool tensor_shapes_equal(const std::vector<int64_t>& lhs,
+                                const std::vector<int64_t>& rhs) {
+  if (lhs.size() != rhs.size()) {
+    return false;
+  }
+  for (size_t i = 0; i < lhs.size(); i++) {
+    if (lhs[i] != rhs[i]) {
+      return false;
+    }
+  }
+  return true;
+}
+
+static Pass::Status IndexGraphInterfaceInstructions(
+    IRContext* context,
+    const std::vector<std::unique_ptr<Instruction>>& instructions,
+    uint32_t index_operand, uint32_t interface_count,
+    std::vector<Instruction*>& instructions_by_index) {
+  instructions_by_index.assign(interface_count, nullptr);
+  for (const auto& instruction : instructions) {
+    const std::string instruction_name =
+        "Op" + std::string(spvOpcodeString(instruction->opcode()));
+    if (index_operand >= instruction->NumInOperands()) {
+      return ShapeFailure(
+          context, instruction_name + " is missing interface index operand");
+    }
+    const uint32_t index_id =
+        instruction->GetSingleWordInOperand(index_operand);
+    const auto interface_index = GetIntegerConstantValue(context, index_id, 32);
+    if (!interface_index.has_value()) {
+      return ShapeFailure(context, instruction_name +
+                                       " interface index must be a known "
+                                       "32-bit integer constant");
+    }
+    const uint32_t index = static_cast<uint32_t>(interface_index.value());
+
+    if (index >= interface_count) {
+      return ShapeFailure(context, instruction_name + " interface index " +
+                                       std::to_string(index) +
+                                       " is outside graph interface range");
+    }
+    if (instructions_by_index[index] != nullptr) {
+      return ShapeFailure(context, "Graph contains duplicate " +
+                                       instruction_name + " index " +
+                                       std::to_string(index));
+    }
+    instructions_by_index[index] = instruction.get();
+  }
+  return Pass::Status::SuccessWithoutChange;
+}
+
+Pass::Status GraphShapePass::ShapeGraphInstruction(Instruction* inst) {
+  switch (inst->opcode()) {
+    case spv::Op::OpExtInst: {
+      if (inst->NumInOperands() == 0) {
+        return ShapeFailure(
+            context(),
+            "OpExtInst graph instruction is missing instruction-set id");
+      }
+      uint32_t iset_id = inst->GetSingleWordInOperand(0);
+      auto iset = context()->get_def_use_mgr()->GetDef(iset_id);
+      if (iset == nullptr || iset->opcode() != spv::Op::OpExtInstImport ||
+          iset->NumInOperands() == 0) {
+        return ShapeFailure(
+            context(),
+            "OpExtInst graph instruction has invalid instruction set id " +
+                std::to_string(iset_id));
+      }
+      auto iset_name = iset->GetInOperand(0).AsString();
+      if (iset_name == "TOSA.001000.1") {
+        return ShapeGraphInstructionTOSA(context(), inst);
+      }
+      if (iset_name == "Arm.MotionEngine.100") {
+        return ShapeGraphInstructionArmMotionEngine(context(), inst);
+      }
+      return ShapeFailure(
+          context(), "Unsupported graph instruction set '" + iset_name + "'");
+    }
+    case spv::Op::OpCompositeExtract:
+      return ShapeGraphCompositeExtract(context(), inst);
+    default:
+      return ShapeFailure(
+          context(), "Unsupported graph body instruction opcode " +
+                         std::to_string(static_cast<uint32_t>(inst->opcode())));
+  }
+}
+
+Pass::Status GraphShapePass::ShapeInterfaceTensorVariable(
+    uint32_t var_id, const std::vector<int64_t>& target_shape) {
+  std::string error_msg;
+  auto existing_tensor_type =
+      GetTensorVariableType(context(), var_id, &error_msg);
+  if (existing_tensor_type == nullptr) {
+    return ShapeFailure(context(), error_msg);
+  }
+
+  if (ValidateTensorRank(
+          context(), "Interface tensor " + std::to_string(var_id),
+          existing_tensor_type, target_shape.size()) == Status::Failure) {
+    return Status::Failure;
+  }
+
+  auto existing_shape = GetTensorTypeShape(context(), existing_tensor_type);
+
+  // Is the tensor already shaped?
+  if (existing_shape.has_value()) {
+    const auto& existing_shape_value = existing_shape.value();
+    if (tensor_shapes_equal(target_shape, existing_shape_value)) {
+      // Yes, and the shape is the one provided by the user, nothing to do
+      return Status::SuccessWithoutChange;
+    }
+    // Yes, but the shape is not the one provided by the user, fail
+    return ShapeFailure(
+        context(), "Tensor " + std::to_string(var_id) + " (" +
+                       FormatOptionalDSB(GetDSBForVar(context(), var_id)) +
+                       ") already shaped with a shape different from that "
+                       "requested: existing shape is " +
+                       FormatShape(existing_shape_value) +
+                       ", requested shape is " + FormatShape(target_shape));
+  }
+
+  // The tensor is not already shaped, we need to shape it
+
+  // Get tensor type
+  error_msg.clear();
+  auto tensor_type = GetOrCreateShapedTensorType(
+      context(), existing_tensor_type->element_type(), target_shape,
+      &error_msg);
+  if (!tensor_type.has_value()) {
+    return ShapeFailure(context(), error_msg);
+  }
+
+  // Get pointer type
+  error_msg.clear();
+  auto storage_class = GetVariableStorageClass(context(), var_id, &error_msg);
+  if (!storage_class.has_value()) {
+    return ShapeFailure(context(), error_msg);
+  }
+  analysis::Pointer ptr_type(tensor_type.value(), storage_class.value());
+  analysis::Type* tensor_pointer_type =
+      context()->get_type_mgr()->GetRegisteredType(&ptr_type);
+
+  // Redefine variable
+  uint32_t pointer_type_id =
+      context()->get_type_mgr()->GetId(tensor_pointer_type);
+  uint32_t new_var_id = TakeNextId();
+  std::unique_ptr<Instruction> new_var(new Instruction(
+      context(), spv::Op::OpVariable, pointer_type_id, new_var_id,
+      {{spv_operand_type_t::SPV_OPERAND_TYPE_OPTIONAL_LITERAL_INTEGER,
+        {uint32_t(storage_class.value())}}}));
+  context()->AddGlobalValue(std::move(new_var));
+  context()->ReplaceAllUsesWith(var_id, new_var_id);
+  context()->KillDef(var_id);
+
+  return Status::SuccessWithChange;
+}
+
+Pass::Status GraphShapePass::ProcessEntryPoint(
+    Instruction& epinst, const MapOfInterfaceTensorShapes& interface_shape_map,
+    std::vector<GraphInterfaceShape>& output_shapes) {
+  const auto& shapes = interface_shape_map;
+  bool changed = false;
+  // Get graph
+  if (epinst.NumInOperands() == 0) {
+    return ShapeFailure(context(),
+                        "OpGraphEntryPointARM is missing graph operand");
+  }
+  auto graph_inst =
+      context()->get_def_use_mgr()->GetDef(epinst.GetSingleWordInOperand(0));
+  if (graph_inst == nullptr) {
+    return ShapeFailure(context(),
+                        "OpGraphEntryPointARM graph id is not defined");
+  }
+  if (graph_inst->opcode() != spv::Op::OpGraphARM) {
+    return ShapeFailure(context(),
+                        "OpGraphEntryPointARM target is not OpGraphARM");
+  }
+  auto graph_type_base =
+      context()->get_type_mgr()->GetType(graph_inst->type_id());
+  if (graph_type_base == nullptr || graph_type_base->AsGraphARM() == nullptr) {
+    return ShapeFailure(context(),
+                        "OpGraphEntryPointARM target is not an OpTypeGraphARM");
+  }
+  auto graph_type = graph_type_base->AsGraphARM();
+  if (graph_type->num_inputs() > graph_type->io_types().size()) {
+    return ShapeFailure(
+        context(),
+        "OpTypeGraphARM input count exceeds graph interface type count");
+  }
+  if (epinst.NumInOperands() != 2 + graph_type->io_types().size()) {
+    return ShapeFailure(context(),
+                        "OpGraphEntryPointARM interface operand count does "
+                        "not match graph type");
+  }
+  for (uint32_t i = 0; i < graph_type->io_types().size(); ++i) {
+    if (graph_type->io_types()[i] == nullptr ||
+        graph_type->io_types()[i]->AsTensorARM() == nullptr) {
+      return ShapeFailure(
+          context(),
+          "Graph shape pass only supports direct OpTypeTensorARM interface "
+          "types; graph interface index " +
+              std::to_string(i));
+    }
+  }
+
+  // Shape interface tensors connected to graph inputs
+  for (uint32_t i = 2; i < 2 + graph_type->num_inputs(); i++) {
+    auto iovar_id = epinst.GetSingleWordInOperand(i);
+    std::string error_msg;
+    auto iovar_ty = GetTensorVariableType(context(), iovar_id, &error_msg);
+    if (iovar_ty == nullptr) {
+      return ShapeFailure(context(), error_msg);
+    }
+    auto dsb = GetDSBForVar(context(), iovar_id);
+    auto existing_shape = GetTensorTypeShape(context(), iovar_ty);
+    std::optional<std::vector<int64_t>> user_shape;
+    if (dsb.has_value()) {
+      auto user_shape_it = shapes.find(dsb.value());
+      if (user_shape_it != shapes.end()) {
+        user_shape = user_shape_it->second;
+      }
+    }
+
+    if (existing_shape.has_value()) {
+      const auto& existing_shape_value = existing_shape.value();
+      if (!user_shape.has_value()) {
+        // Existing interface shape is enough when no user shape is supplied.
+        continue;
+      }
+      const auto& user_shape_value = user_shape.value();
+      if (tensor_shapes_equal(existing_shape_value, user_shape_value)) {
+        // Existing interface shape agrees with the user shape.
+        continue;
+      }
+      return ShapeFailure(
+          context(),
+          "Existing interface tensor shape mismatched user supplied shape for "
+          "tensor " +
+              std::to_string(iovar_id) + " (" + FormatDSB(dsb.value()) +
+              "): existing shape is " + FormatShape(existing_shape_value) +
+              ", user supplied shape is " + FormatShape(user_shape_value));
+    }
+
+    if (!user_shape.has_value()) {
+      if (graph_type->is_shaped()) {
+        continue;
+      }
+      return ShapeFailure(
+          context(), "No user-supplied shape for interface tensor " +
+                         std::to_string(iovar_id) + " at graph input " +
+                         std::to_string(i - 2) + " (" + FormatOptionalDSB(dsb) +
+                         ")");
+    }
+
+    // The interface tensor needs shaping
+    auto status = ShapeInterfaceTensorVariable(iovar_id, user_shape.value());
+    if (status == Status::Failure) {
+      return status;
+    }
+    if (status == Status::SuccessWithChange) {
+      changed = true;
+    }
+  }
+
+  // Is the graph already shaped?
+  if (graph_type->is_shaped()) {
+    // The graph type is already the authoritative shape contract. Make sure
+    // each entry-point interface variable is compatible with that contract.
+    for (uint32_t i = 0; i < graph_type->io_types().size(); i++) {
+      auto tensor_type_graph = graph_type->io_types()[i]->AsTensorARM();
+      if (tensor_type_graph == nullptr) {
+        return ShapeFailure(context(), "Graph interface type at index " +
+                                           std::to_string(i) +
+                                           " is not OpTypeTensorARM");
+      }
+      auto tensor_interface_var_id = epinst.GetSingleWordInOperand(2 + i);
+      std::string error_msg;
+      auto tensor_type_interface =
+          GetTensorVariableType(context(), tensor_interface_var_id, &error_msg);
+      if (tensor_type_interface == nullptr) {
+        return ShapeFailure(context(), error_msg);
+      }
+      auto graph_shape = GetTensorTypeShape(context(), tensor_type_graph);
+      if (!graph_shape.has_value()) {
+        return ShapeFailure(context(),
+                            "Existing graph type is marked shaped but graph "
+                            "interface index " +
+                                std::to_string(i) + " has no shape");
+      }
+      const auto& graph_shape_value = graph_shape.value();
+      // A user-supplied shape for this resource must agree with the already
+      // shaped graph type; there is no inference step that can reconcile it.
+      auto dsb = GetDSBForVar(context(), tensor_interface_var_id);
+      if (dsb.has_value()) {
+        auto user_shape_it = shapes.find(dsb.value());
+        if (user_shape_it != shapes.end() &&
+            !tensor_shapes_equal(user_shape_it->second, graph_shape_value)) {
+          return ShapeFailure(
+              context(),
+              "User-supplied shape mismatches existing graph shape for "
+              "interface tensor " +
+                  std::to_string(tensor_interface_var_id) +
+                  " at graph interface index " + std::to_string(i) + " (" +
+                  FormatDSB(dsb.value()) + "): graph shape is " +
+                  FormatShape(graph_shape_value) + ", user supplied shape is " +
+                  FormatShape(user_shape_it->second));
+        }
+      }
+
+      // If the interface variable is already shaped, it must match the graph
+      // interface tensor shape. If it is still unshaped, shape it below.
+      auto interface_shape =
+          GetTensorTypeShape(context(), tensor_type_interface);
+      if (interface_shape.has_value() &&
+          !tensor_shapes_equal(graph_shape_value, interface_shape.value())) {
+        return ShapeFailure(
+            context(),
+            "Mismatch between existing graph shape and interface tensor shape "
+            "at graph interface index " +
+                std::to_string(i) + " for interface tensor " +
+                std::to_string(tensor_interface_var_id) + " (" +
+                FormatOptionalDSB(dsb) + "): graph shape is " +
+                FormatShape(graph_shape_value) +
+                ", interface tensor shape is " +
+                FormatShape(interface_shape.value()));
+      }
+
+      // The graph is already shaped but the entry-point variable is not; update
+      // the variable so the graph entry point remains type-consistent.
+      if (!interface_shape.has_value()) {
+        auto status = ShapeInterfaceTensorVariable(tensor_interface_var_id,
+                                                   graph_shape_value);
+        if (status == Status::Failure) {
+          return status;
+        }
+        if (status == Status::SuccessWithChange) {
+          changed = true;
+        }
+      }
+      if (i >= graph_type->num_inputs() && dsb.has_value()) {
+        output_shapes.push_back({dsb->first, dsb->second, graph_shape_value});
+      }
+    }
+    return changed ? Status::SuccessWithChange : Status::SuccessWithoutChange;
+  }
+  // The graph needs shaping
+
+  changed = true;
+  std::vector<const analysis::Type*> shaped_graph_io_types;
+
+  // Mutate type of graph inputs
+  auto graph = context()->GetGraph(graph_inst);
+  if (graph == nullptr) {
+    return ShapeFailure(context(),
+                        "Graph shape pass could not retrieve graph body");
+  }
+
+  const uint32_t num_inputs = graph_type->num_inputs();
+  const uint32_t num_outputs =
+      static_cast<uint32_t>(graph_type->io_types().size()) - num_inputs;
+  std::vector<Instruction*> inputs_by_index;
+  if (IndexGraphInterfaceInstructions(context(), graph->inputs(), 0, num_inputs,
+                                      inputs_by_index) == Status::Failure) {
+    return Status::Failure;
+  }
+
+  std::vector<Instruction*> outputs_by_index;
+  if (IndexGraphInterfaceInstructions(context(), graph->outputs(), 1,
+                                      num_outputs,
+                                      outputs_by_index) == Status::Failure) {
+    return Status::Failure;
+  }
+  for (uint32_t i = 0; i < num_outputs; ++i) {
+    if (outputs_by_index[i] == nullptr) {
+      return ShapeFailure(
+          context(),
+          "Graph is missing OpGraphSetOutputARM index " + std::to_string(i));
+    }
+  }
+
+  for (uint32_t i = 0; i < num_inputs; i++) {
+    std::string error_msg;
+    auto iovar_ty = GetTensorVariableType(
+        context(), epinst.GetSingleWordInOperand(i + 2), &error_msg);
+    if (iovar_ty == nullptr) {
+      return ShapeFailure(context(), error_msg);
+    }
+    shaped_graph_io_types.push_back(iovar_ty);
+    auto input_type_id =
+        context()->get_type_mgr()->GetTypeInstruction(iovar_ty);
+    if (input_type_id == 0) {
+      return ShapeFailure(context(), "Graph input tensor type has no type id");
+    }
+    if (inputs_by_index[i] != nullptr) {
+      inputs_by_index[i]->SetResultType(input_type_id);
+    }
+  }
+  // Mutate body instructions
+  for (auto& binst : graph->instructions()) {
+    auto status = ShapeGraphInstruction(binst.get());
+    if (status == Status::Failure) {
+      return status;
+    }
+    if (status == Status::SuccessWithChange) {
+      changed = true;
+    }
+  }
+  // Collect graph output types
+  for (uint32_t i = 0; i < outputs_by_index.size(); i++) {
+    auto output_inst = outputs_by_index[i];
+    if (output_inst->NumInOperands() == 0) {
+      return ShapeFailure(
+          context(), "OpGraphSetOutputARM is missing output value operand");
+    }
+    auto output_val_id = output_inst->GetSingleWordInOperand(0);
+    auto output_val = context()->get_def_use_mgr()->GetDef(output_val_id);
+    if (output_val == nullptr) {
+      return ShapeFailure(context(), "Graph output value " +
+                                         std::to_string(output_val_id) +
+                                         " is not defined");
+    }
+    auto tensor_type = GetTensorResultType(context(), output_val);
+    if (tensor_type == nullptr) {
+      return ShapeFailure(context(), "Graph output value " +
+                                         std::to_string(output_val_id) +
+                                         " is not OpTypeTensorARM");
+    }
+    shaped_graph_io_types.push_back(tensor_type);
+  }
+  // Mutate graph type
+  analysis::GraphARM new_gtype(graph_type->num_inputs(), shaped_graph_io_types);
+  analysis::Type* new_graph_type =
+      context()->get_type_mgr()->GetRegisteredType(&new_gtype);
+  auto new_graph_type_id =
+      context()->get_type_mgr()->GetTypeInstruction(new_graph_type);
+  if (new_graph_type_id == 0) {
+    return ShapeFailure(context(), "Shaped graph type has no type id");
+  }
+  graph_inst->SetResultType(new_graph_type_id);
+
+  // Shape output interface tensors
+  for (uint32_t i = 0; i < outputs_by_index.size(); i++) {
+    uint32_t output_var_id =
+        epinst.GetSingleWordInOperand(2 + graph_type->num_inputs() + i);
+    auto target_shape = GetTensorShape(
+        context(), outputs_by_index[i]->GetSingleWordInOperand(0));
+    if (!target_shape.has_value()) {
+      return ShapeFailure(context(), "Graph output tensor shape must be known");
+    }
+    const auto& target_shape_value = target_shape.value();
+    auto dsb = GetDSBForVar(context(), output_var_id);
+    if (dsb.has_value() && shapes.count(dsb.value()) != 0) {
+      auto const& user_shape = shapes.at(dsb.value());
+      if (!tensor_shapes_equal(user_shape, target_shape_value)) {
+        return ShapeFailure(
+            context(),
+            "User-supplied output shape mismatches inferred graph output "
+            "shape for tensor " +
+                std::to_string(output_var_id) + " at graph output " +
+                std::to_string(i) + " (" + FormatDSB(dsb.value()) +
+                "): inferred shape is " + FormatShape(target_shape_value) +
+                ", user supplied shape is " + FormatShape(user_shape));
+      }
+    }
+    auto status =
+        ShapeInterfaceTensorVariable(output_var_id, target_shape_value);
+    if (status == Status::Failure) {
+      return status;
+    }
+    if (status == Status::SuccessWithChange) {
+      changed = true;
+    }
+    if (dsb.has_value()) {
+      output_shapes.push_back({dsb->first, dsb->second, target_shape_value});
+    }
+  }
+
+  return changed ? Status::SuccessWithChange : Status::SuccessWithoutChange;
+}
+
+Pass::Status GraphShapePass::Process() {
+  MapOfInterfaceTensorShapes interface_shape_map;
+  auto interface_shape_status =
+      ValidateAndBuildInterfaceTensorShapeMap(&interface_shape_map);
+  if (interface_shape_status == Status::Failure) {
+    return interface_shape_status;
+  }
+
+  if (ValidateInterfaceTensorShapeResources(interface_shape_map) ==
+      Status::Failure) {
+    return Status::Failure;
+  }
+
+  auto topology_status = ValidateGraphEntryPointTopology();
+  if (topology_status == Status::Failure) {
+    return topology_status;
+  }
+
+  bool changed = false;
+  std::vector<GraphInterfaceShape> output_shapes;
+
+  // For all graph entry points
+  for (auto& ep : context()->module()->graph_entry_points()) {
+    auto status = ProcessEntryPoint(ep, interface_shape_map, output_shapes);
+    if (status == Status::Failure) {
+      return status;
+    }
+    if (status == Status::SuccessWithChange) {
+      changed = true;
+    }
+  }
+
+  if (output_shape_consumer_) {
+    output_shape_consumer_(output_shapes);
+  }
+
+  return changed ? Status::SuccessWithChange : Status::SuccessWithoutChange;
+}
