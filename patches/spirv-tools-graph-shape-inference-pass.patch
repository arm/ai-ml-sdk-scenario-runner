+  *output_shape = input_shape.value();
+  return Pass::Status::SuccessWithoutChange;
+}
+
+Pass::Status BroadcastShapes(IRContext* context,
+                             const std::vector<int64_t>& input1_shape,
+                             const std::vector<int64_t>& input2_shape,
+                             std::vector<int64_t>* output_shape) {
+  if (input1_shape.size() != input2_shape.size()) {
+    return ShapeFailure(context, "Input ranks mismatch");
+  }
+  output_shape->clear();
+  output_shape->reserve(input1_shape.size());
+  for (size_t i = 0; i < input1_shape.size(); ++i) {
+    if (input1_shape[i] != input2_shape[i] && input1_shape[i] != 1 &&
+        input2_shape[i] != 1) {
+      return ShapeFailure(context, "Input shapes are not broadcast-compatible");
+    }
+    output_shape->push_back(std::max(input1_shape[i], input2_shape[i]));
+  }
+
+  return Pass::Status::SuccessWithoutChange;
+}
+
+Pass::Status ShapeGraphInstructionMatchOutputWithCheck(
+    IRContext* context, uint32_t input1_id, uint32_t input2_id,
+    std::vector<int64_t>* output_shape) {
+  auto input1_shape = GetTensorShape(context, input1_id);
+  if (!input1_shape) {
+    return ShapeFailure(context, "Input 1 shape must be known");
+  }
+  auto input2_shape = GetTensorShape(context, input2_id);
+  if (!input2_shape) {
+    return ShapeFailure(context, "Input 2 shape must be known");
+  }
+
+  return BroadcastShapes(context, input1_shape.value(), input2_shape.value(),
+                         output_shape);
+}
