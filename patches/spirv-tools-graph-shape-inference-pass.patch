+
+namespace spvtools {
+namespace opt {
+
+using ::spvtools::GraphInterfaceShape;
+using ::spvtools::GraphOutputShapeConsumer;
+
+class GraphShapePass : public Pass {
+ public:
+  GraphShapePass(
+      const std::vector<GraphInterfaceShape>& interface_tensor_shapes,
+      GraphOutputShapeConsumer output_shape_consumer = {})
+      : interface_shape_requests_(interface_tensor_shapes),
+        output_shape_consumer_(std::move(output_shape_consumer)) {}
+
+  Status Process() override;
+  const char* name() const override { return "graph-shape"; }
+
+  static std::unique_ptr<std::vector<GraphInterfaceShape>>
+  ParseInterfaceTensorShapesString(const char* str,
+                                   std::string* error_msg = nullptr);
+
+ private:
+  // Descriptor-set/binding pair identifying a graph interface tensor.
+  // |first| is the descriptor set and |second| is the binding.
+  using InterfaceTensorShapeKey = std::pair<uint32_t, uint32_t>;
+
+  struct InterfaceTensorShapeKeyHash {
+    size_t operator()(const InterfaceTensorShapeKey key) const {
+      const auto packed = (uint64_t{key.first} << 32) | uint64_t{key.second};
+      return std::hash<uint64_t>{}(packed);
+    }
+  };
+
+  using MapOfInterfaceTensorShapes =
+      std::unordered_map<InterfaceTensorShapeKey, std::vector<int64_t>,
+                         InterfaceTensorShapeKeyHash>;
+
+  Pass::Status ValidateAndBuildInterfaceTensorShapeMap(
+      MapOfInterfaceTensorShapes* interface_shape_map) const;
+  Pass::Status ValidateInterfaceTensorShapeResources(
+      const MapOfInterfaceTensorShapes& interface_shape_map) const;
+  Pass::Status ValidateGraphEntryPointTopology() const;
+  Pass::Status ShapeInterfaceTensorVariable(
+      uint32_t var_id, const std::vector<int64_t>& target_shape);
+  Pass::Status ShapeGraphInstruction(Instruction* inst);
+  Pass::Status ProcessEntryPoint(
+      Instruction& epinst,
+      const MapOfInterfaceTensorShapes& interface_shape_map,
+      std::vector<GraphInterfaceShape>& output_shapes);
+
+  std::vector<GraphInterfaceShape> interface_shape_requests_;
+  GraphOutputShapeConsumer output_shape_consumer_;
+};
+// Copies raw C API shape entries into the owned C++ request list. This only
+// validates pointer/count safety; shape contents are validated by the pass.
+bool CopyGraphInterfaceShapes(
+    size_t num_interface_shapes,
+    const spv_graph_interface_shape* interface_shape_inputs,
+    std::vector<GraphInterfaceShape>* interface_shapes, std::string* error_msg);
+
+}  // namespace opt
