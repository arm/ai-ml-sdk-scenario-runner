+Pass::Status ShapeGraphInstructionAvgMaxPool2dOps(
+    IRContext* context, uint32_t kernel_id, uint32_t stride_id, uint32_t pad_id,
+    uint32_t input_id, std::vector<int64_t>* output_shape) {
+  std::vector<int32_t> kernel;
+  if (GetI32TensorConstantValues(context, "Pool kernel", kernel_id, 2,
+                                 &kernel) == Pass::Status::Failure) {
+    return Pass::Status::Failure;
+  }
+  int32_t kernel_y = kernel[0];
+  int32_t kernel_x = kernel[1];
+
+  std::vector<int32_t> stride;
+  if (GetI32TensorConstantValues(context, "Pool stride", stride_id, 2,
+                                 &stride) == Pass::Status::Failure) {
+    return Pass::Status::Failure;
+  }
+  int32_t stride_y = stride[0];
+  int32_t stride_x = stride[1];
+
+  std::vector<int32_t> pad;
+  if (GetI32TensorConstantValues(context, "Pool pad", pad_id, 4, &pad) ==
+      Pass::Status::Failure) {
+    return Pass::Status::Failure;
+  }
+  int32_t pad_top = pad[0];
+  int32_t pad_bottom = pad[1];
+  int32_t pad_left = pad[2];
+  int32_t pad_right = pad[3];
+
+  auto input_shape = GetTensorShape(context, input_id);
+  if (!input_shape) {
+    return ShapeFailure(context, "Pool input shape must be known");
+  }
+  if (input_shape.value().size() != 4) {
+    return ShapeFailure(context, "Pool input tensor must be rank 4");
+  }
+  if (kernel_y <= 0 || kernel_x <= 0) {
+    return ShapeFailure(context,
+                        "Pool kernel values must be greater than zero");
+  }
+  if (ValidateSpatialParameters(context, "Pool", pad, stride) ==
+      Pass::Status::Failure) {
+    return Pass::Status::Failure;
+  }
+  if (pad_top >= kernel_y || pad_bottom >= kernel_y || pad_left >= kernel_x ||
+      pad_right >= kernel_x) {
+    return ShapeFailure(context,
+                        "Pool padding values must be less than kernel extent");
+  }
+
+  auto N = input_shape.value()[0];
+  auto IH = input_shape.value()[1];
+  auto IW = input_shape.value()[2];
+  auto C = input_shape.value()[3];
+
+  int64_t OH;
+  int64_t OW;
+  if (CheckedOutputExtent(context, "Pool height", IH, kernel_y, pad_top,
+                          pad_bottom, 1, stride_y,
+                          &OH) == Pass::Status::Failure ||
+      CheckedOutputExtent(context, "Pool width", IW, kernel_x, pad_left,
+                          pad_right, 1, stride_x,
+                          &OW) == Pass::Status::Failure) {
+    return Pass::Status::Failure;
+  }
+
+  *output_shape = {N, OH, OW, C};
+  return Pass::Status::SuccessWithoutChange;
+}
