+template <typename OperandTraits>
+class ExtInstOperandReader {
+ public:
+  using OperandRole = typename OperandTraits::OperandRole;
+
+  ExtInstOperandReader(IRContext* context, const Instruction* inst)
+      : context_(context), inst_(inst), extinst_opcode_(0) {}
+
+  Pass::Status ReadOpcode() {
+    return ReadInOperand(
+        context_, inst_, OperandTraits::kExtInstOpcode,
+        std::string(OperandTraits::InstructionSetName()) + " opcode",
+        &extinst_opcode_);
+  }
+
+  uint32_t opcode() const { return extinst_opcode_; }
+
+  Pass::Status ReadOperands(
+      std::initializer_list<std::pair<OperandRole, uint32_t*> > requests)
+      const {
+    for (const auto& [role, id] : requests) {
+      uint32_t operand_index = OperandIndex(extinst_opcode_, role);
+      if (operand_index == OperandTraits::kInvalidOperand) {
+        return ShapeFailure(context_, OperandName(role) + " is not defined");
+      }
+      if (ReadInOperand(context_, inst_, operand_index, OperandName(role),
+                        id) == Pass::Status::Failure) {
+        return Pass::Status::Failure;
+      }
+    }
+    return Pass::Status::SuccessWithoutChange;
+  }
+
+  Pass::Status ReadVariadic(OperandRole role,
+                            std::vector<uint32_t>* ids) const {
+    uint32_t first_operand_index = OperandIndex(extinst_opcode_, role);
+    if (first_operand_index == OperandTraits::kInvalidOperand) {
+      return ShapeFailure(context_, OperandName(role) + " is not defined");
+    }
+    if (first_operand_index >= inst_->NumInOperands()) {
+      return ShapeFailure(context_, OperandName(role) + " is missing");
+    }
+
+    ids->clear();
+    ids->reserve(inst_->NumInOperands() - first_operand_index);
+    const std::string operand_name = OperandName(role);
+    for (uint32_t operand_index = first_operand_index;
+         operand_index < inst_->NumInOperands(); ++operand_index) {
+      uint32_t id = 0;
+      if (ReadInOperand(context_, inst_, operand_index, operand_name, &id) ==
+          Pass::Status::Failure) {
+        return Pass::Status::Failure;
+      }
+      ids->push_back(id);
+    }
+    return Pass::Status::SuccessWithoutChange;
+  }
+
+ private:
+  std::string ExtInstName() const {
+    const ExtInstDesc* desc = nullptr;
+    if (LookupExtInst(OperandTraits::kExtInstType, extinst_opcode_, &desc) ==
+        SPV_SUCCESS) {
+      return std::string(OperandTraits::InstructionSetName()) + " " +
+             desc->name().data();
+    }
+    return std::string(OperandTraits::InstructionSetName()) + " opcode " +
+           std::to_string(extinst_opcode_);
+  }
+
+  std::string OperandName(OperandRole role) const {
+    return ExtInstName() + " operand " + RoleName(role);
+  }
+
+  static const char* RoleName(OperandRole role) {
+    return OperandRoleName(role);
+  }
+
+  static uint32_t OperandIndex(uint32_t extinst_opcode, OperandRole role) {
+    return GetOperandIndex(extinst_opcode, role);
+  }
+
+  static Pass::Status ReadInOperand(IRContext* context, const Instruction* inst,
+                                    uint32_t operand_index,
+                                    const std::string& name, uint32_t* id) {
+    if (operand_index >= inst->NumInOperands()) {
+      return ShapeFailure(context, name + " is missing");
+    }
+    const auto& operand = inst->GetInOperand(operand_index);
+    if (operand.words.size() != 1) {
+      return ShapeFailure(context, name + " must be a single-word operand");
+    }
+    *id = operand.words[0];
+    return Pass::Status::SuccessWithoutChange;
+  }
+
+  IRContext* context_;
+  const Instruction* inst_;
+  uint32_t extinst_opcode_;
+};
+
+}  // namespace opt
+}  // namespace spvtools
+
+#endif  // SOURCE_OPT_GRAPH_SHAPE_EXTINST_OPERAND_READER_H_
