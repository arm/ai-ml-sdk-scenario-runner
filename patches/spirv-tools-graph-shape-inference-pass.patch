+Pass::Status ShapeGraphInstructionMatchOutput(
+    IRContext* context, uint32_t input_id, std::vector<int64_t>* output_shape) {
+  auto input_shape = GetTensorShape(context, input_id);
+  if (!input_shape) {
+    return ShapeFailure(context, "Input shape must be known");
