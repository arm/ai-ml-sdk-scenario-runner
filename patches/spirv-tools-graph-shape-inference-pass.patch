+Pass::Status ShapeGraphInstructionTransposeConv2dOp(
+    IRContext* context, uint32_t out_pad_id, uint32_t stride_id,
+    uint32_t input_id, uint32_t weights_id,
+    std::vector<int64_t>* output_shape) {
+  std::vector<int32_t> out_pad;
+  if (GetI32TensorConstantValues(context, "Transpose Conv2D output padding",
+                                 out_pad_id, 4,
+                                 &out_pad) == Pass::Status::Failure) {
+    return Pass::Status::Failure;
+  }
+  int32_t out_pad_top = out_pad[0];
+  int32_t out_pad_bottom = out_pad[1];
+  int32_t out_pad_left = out_pad[2];
+  int32_t out_pad_right = out_pad[3];
+
+  std::vector<int32_t> stride;
+  if (GetI32TensorConstantValues(context, "Transpose Conv2D stride", stride_id,
+                                 2, &stride) == Pass::Status::Failure) {
+    return Pass::Status::Failure;
+  }
+  int32_t stride_y = stride[0];
+  int32_t stride_x = stride[1];
+
+  auto input_shape = GetTensorShape(context, input_id);
+  if (!input_shape) {
+    return ShapeFailure(context, "Transpose Conv2D input shape must be known");
+  }
+  if (input_shape.value().size() != 4) {
+    return ShapeFailure(context,
+                        "Transpose Conv2D input tensor must be rank 4");
+  }
+
+  auto N = input_shape.value()[0];
+  auto IH = input_shape.value()[1];
+  auto IW = input_shape.value()[2];
+
+  auto weights_shape = GetTensorShape(context, weights_id);
+  if (!weights_shape) {
+    return ShapeFailure(context,
+                        "Transpose Conv2D weights shape must be known");
+  }
+  if (weights_shape.value().size() != 4) {
+    return ShapeFailure(context,
+                        "Transpose Conv2D weights tensor must be rank 4");
+  }
+
+  auto KO = weights_shape.value()[0];
+  auto KH = weights_shape.value()[1];
+  auto KW = weights_shape.value()[2];
+  if (std::any_of(stride.begin(), stride.end(),
+                  [](int32_t value) { return value <= 0; })) {
+    return ShapeFailure(
+        context, "Transpose Conv2D stride values must be greater than zero");
+  }
+  if (out_pad_top <= -KH || out_pad_bottom <= -KH || out_pad_left <= -KW ||
+      out_pad_right <= -KW) {
+    return ShapeFailure(
+        context,
+        "Transpose Conv2D output padding must be greater than the negated "
+        "kernel extent");
+  }
+
+  auto checked_transpose_extent =
+      [context](std::string_view name, int64_t input, int64_t stride_value,
+                int64_t pad_before, int64_t pad_after, int64_t kernel,
+                int64_t* output) {
+        int64_t input_minus_one;
+        if (!CheckedSub(input, 1, &input_minus_one) ||
+            !CheckedMul(input_minus_one, stride_value, output) ||
+            !CheckedAdd(*output, pad_before, output) ||
+            !CheckedAdd(*output, pad_after, output) ||
+            !CheckedAdd(*output, kernel, output)) {
+          return ShapeFailure(
+              context, std::string(name) + " arithmetic overflows int64_t");
+        }
+        return ValidateOutputDimension(context, name, *output);
+      };
+
+  int64_t OH;
+  int64_t OW;
+  if (checked_transpose_extent("Transpose Conv2D height", IH, stride_y,
+                               out_pad_top, out_pad_bottom, KH,
+                               &OH) == Pass::Status::Failure ||
+      checked_transpose_extent("Transpose Conv2D width", IW, stride_x,
+                               out_pad_left, out_pad_right, KW,
+                               &OW) == Pass::Status::Failure) {
+    return Pass::Status::Failure;
+  }
+
+  *output_shape = {N, OH, OW, KO};
+  return Pass::Status::SuccessWithoutChange;
+}
+
+Pass::Status ShapeGraphInstructionResizeOp(IRContext* context,
+                                           uint32_t input_id, uint32_t scale_id,
+                                           uint32_t offset_id,
+                                           uint32_t border_id,
+                                           std::vector<int64_t>* output_shape) {
+  auto input_shape = GetTensorShape(context, input_id);
+  if (!input_shape) {
+    return ShapeFailure(context, "Resize input shape must be known");
+  }
+  if (input_shape.value().size() != 4) {
+    return ShapeFailure(context, "Resize input tensor must be rank 4");
+  }
+
+  auto N = input_shape.value()[0];
+  auto IH = input_shape.value()[1];
+  auto IW = input_shape.value()[2];
+  auto IC = input_shape.value()[3];
+
+  std::vector<int32_t> scale;
+  if (GetI32TensorConstantValues(context, "Resize scale", scale_id, 4,
+                                 &scale) == Pass::Status::Failure) {
+    return Pass::Status::Failure;
+  }
+  int32_t scale_y_n = scale[0];
+  int32_t scale_y_d = scale[1];
+  int32_t scale_x_n = scale[2];
+  int32_t scale_x_d = scale[3];
+
+  std::vector<int32_t> offset;
+  if (GetI32TensorConstantValues(context, "Resize offset", offset_id, 2,
+                                 &offset) == Pass::Status::Failure) {
+    return Pass::Status::Failure;
+  }
+  int32_t offset_y = offset[0];
+  int32_t offset_x = offset[1];
+
+  std::vector<int32_t> border;
+  if (GetI32TensorConstantValues(context, "Resize border", border_id, 2,
+                                 &border) == Pass::Status::Failure) {
+    return Pass::Status::Failure;
+  }
+  int32_t border_y = border[0];
+  int32_t border_x = border[1];
+
+  if (scale_y_n <= 0 || scale_x_n <= 0) {
+    return ShapeFailure(context,
+                        "Resize scale numerators must be greater than zero");
+  }
+  if (scale_y_d <= 0 || scale_x_d <= 0) {
+    return ShapeFailure(context,
+                        "Resize scale denominators must be greater than zero");
+  }
+  const int64_t scale_y_n_64 = scale_y_n;
+  const int64_t scale_x_n_64 = scale_x_n;
+  if (scale_y_d >= kResizeParameterLimit * scale_y_n_64 ||
+      scale_x_d >= kResizeParameterLimit * scale_x_n_64) {
+    return ShapeFailure(
+        context,
+        "Resize scale denominator must be less than 16 times its "
+        "numerator");
+  }
+  if (offset_y < -scale_y_n_64 ||
+      offset_y >= kResizeParameterLimit * scale_y_n_64 ||
+      offset_x < -scale_x_n_64 ||
+      offset_x >= kResizeParameterLimit * scale_x_n_64) {
+    return ShapeFailure(context,
+                        "Resize offset values are outside the valid range");
+  }
+  if (border_y < -kResizeParameterLimit * scale_y_n_64 ||
+      border_y >= scale_y_n_64 ||
+      border_x < -kResizeParameterLimit * scale_x_n_64 ||
+      border_x >= scale_x_n_64) {
+    return ShapeFailure(context,
+                        "Resize border values are outside the valid range");
+  }
+  auto checked_resize_extent =
+      [context](std::string_view name, int64_t input, int64_t scale_numerator,
+                int64_t offset_value, int64_t border_value,
+                int64_t scale_denominator, int64_t* output) {
+        int64_t input_minus_one;
+        int64_t numerator;
+        if (!CheckedSub(input, 1, &input_minus_one) ||
+            !CheckedMul(input_minus_one, scale_numerator, &numerator) ||
+            !CheckedSub(numerator, offset_value, &numerator) ||
+            !CheckedAdd(numerator, border_value, &numerator)) {
+          return ShapeFailure(
+              context, std::string(name) + " arithmetic overflows int64_t");
+        }
+
+        int64_t quotient;
+        auto status = CheckedExactDivide(context, numerator, scale_denominator,
+                                         name, &quotient);
+        if (status == Pass::Status::Failure) {
+          return status;
+        }
+        if (!CheckedAdd(quotient, 1, output)) {
+          return ShapeFailure(
+              context, std::string(name) + " output extent overflows int64_t");
+        }
+        return ValidateOutputDimension(context, name, *output);
+      };
+
+  int64_t OH;
+  int64_t OW;
+  if (checked_resize_extent("Resize height", IH, scale_y_n, offset_y, border_y,
+                            scale_y_d, &OH) == Pass::Status::Failure ||
+      checked_resize_extent("Resize width", IW, scale_x_n, offset_x, border_x,
+                            scale_x_d, &OW) == Pass::Status::Failure) {
+    return Pass::Status::Failure;
+  }
+
+  *output_shape = {N, OH, OW, IC};
+  return Pass::Status::SuccessWithoutChange;
+}
+
+Pass::Status ShapeGraphInstructionConcatOp(
+    IRContext* context, uint32_t axis_id,
+    const std::vector<uint32_t>& input_ids,
+    std::vector<int64_t>* output_shape) {
+  uint32_t axis = 0;
+  if (GetAxisConstant(context, "Concat", axis_id, &axis) ==
+      Pass::Status::Failure) {
+    return Pass::Status::Failure;
+  }
+
+  if (input_ids.empty()) {
+    return ShapeFailure(context, "Concat must have at least one input tensor");
+  }
+
+  auto first_input_id = input_ids.front();
+  auto first_input_shape = GetTensorShape(context, first_input_id);
+  if (!first_input_shape) {
+    return ShapeFailure(context, "Concat input tensor shape must be known");
+  }
+  if (axis >= first_input_shape.value().size()) {
+    return ShapeFailure(context, "Concat axis outside of input tensor rank");
+  }
+
+  std::vector<int64_t> concat_shape = first_input_shape.value();
+  concat_shape[axis] = 0;
+  for (uint32_t input_id : input_ids) {
+    auto input_shape = GetTensorShape(context, input_id);
+    if (!input_shape) {
+      return ShapeFailure(context, "Concat input tensor shape must be known");
+    }
+    if (input_shape.value().size() != first_input_shape.value().size()) {
+      return ShapeFailure(context, "Concat input ranks mismatch");
+    }
+    for (size_t dim = 0; dim < input_shape.value().size(); ++dim) {
+      if (dim != axis) {
+        if (input_shape.value()[dim] != first_input_shape.value()[dim]) {
+          return ShapeFailure(
+              context, "Concat input shapes mismatch on a non-concat axis");
+        }
+      }
+    }
+    int64_t concat_axis_dim;
+    if (!CheckedAdd(concat_shape[axis], input_shape.value()[axis],
+                    &concat_axis_dim)) {
+      return ShapeFailure(
+          context, "Concat output concat-axis dimension overflows int64_t");
+    }
+    if (ValidateOutputDimension(context, "Concat output concat-axis",
+                                concat_axis_dim) == Pass::Status::Failure) {
+      return Pass::Status::Failure;
+    }
+    concat_shape[axis] = concat_axis_dim;
+  }
+
+  *output_shape = concat_shape;
+  return Pass::Status::SuccessWithoutChange;
+}
+
+Pass::Status ShapeGraphInstructionReshapeOp(
+    IRContext* context, uint32_t shape_id, std::vector<int64_t>* output_shape) {
+  auto shape_rank_tensor = GetTensorShape(context, shape_id);
+  if (!shape_rank_tensor) {
+    return ShapeFailure(context, "Reshape shape shape must be known");
+  }
+  if (shape_rank_tensor.value().size() != 1) {
+    return ShapeFailure(context, "New shape tensor should be of rank 1");
+  }
+
+  size_t rank = static_cast<size_t>(shape_rank_tensor.value()[0]);
+
+  std::vector<int32_t> new_shape;
+  if (GetI32TensorConstantValues(context, "Reshape new shape", shape_id, rank,
+                                 &new_shape) == Pass::Status::Failure) {
+    return Pass::Status::Failure;
+  }
+  for (int64_t dim : new_shape) {
+    if (dim <= 0) {
+      return ShapeFailure(
+          context, "Reshape output dimensions must be greater than zero");
+    }
+  }
+
+  output_shape->clear();
+  output_shape->reserve(new_shape.size());
+
+  for (int32_t dim : new_shape) {
+    output_shape->emplace_back(static_cast<int64_t>(dim));
+  }
+
+  return Pass::Status::SuccessWithoutChange;
+}
