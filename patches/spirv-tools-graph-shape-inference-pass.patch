+Pass::Status ShapeGraphInstructionTileOp(IRContext* context, uint32_t input_id,
+                                         uint32_t multiples_id,
+                                         std::vector<int64_t>* inferred_shape) {
+  auto input_shape = GetTensorShape(context, input_id);
+  if (!input_shape) {
+    return ShapeFailure(context, "Tile input shape must be known");
+  }
+
+  auto multiples_shape = GetTensorShape(context, multiples_id);
+  if (!multiples_shape) {
+    return ShapeFailure(context, "Tile multiples shape must be known");
+  }
+  int64_t input_rank = static_cast<int64_t>(input_shape.value().size());
+  if (multiples_shape.value().size() != 1 ||
+      multiples_shape.value()[0] != input_rank) {
+    return ShapeFailure(context, "Tile multiples shape must be [rank(input1)]");
+  }
+
+  std::vector<int32_t> multiples;
+  if (GetI32TensorConstantValues(context, "Tile multiples", multiples_id,
+                                 input_shape.value().size(),
+                                 &multiples) == Pass::Status::Failure) {
+    return Pass::Status::Failure;
+  }
+
+  std::vector<int64_t> output_shape;
+  output_shape.reserve(input_shape.value().size());
+  for (size_t i = 0; i < input_shape.value().size(); ++i) {
+    if (multiples[i] < 1) {
+      return ShapeFailure(context, "Tile multiples must be greater than zero");
+    }
+    int64_t output_dim;
+    if (!CheckedMul(input_shape.value()[i], multiples[i], &output_dim)) {
+      return ShapeFailure(context, "Tile output dimension overflows int64_t");
+    }
+    if (ValidateOutputDimension(context, "Tile output", output_dim) ==
+        Pass::Status::Failure) {
+      return Pass::Status::Failure;
+    }
+    output_shape.push_back(output_dim);
+  }
+
+  *inferred_shape = output_shape;
+  return Pass::Status::SuccessWithoutChange;
+}
